# Go process memory/CPU baseline for the dear-agent ecosystem.
#
# Single source of truth for the GC/memory/CPU envelope every Go binary in
# this repo runs under. Source this from Makefile targets (build/test) and
# from daemon launch wrappers (launchd plists) so agm, vroom-dispatch,
# mergeloop, the agm-bus broker, and dev build/test runs all share one
# bounded envelope instead of growing unbounded.
#
# Tune per-process-class by overriding the var in the specific wrapper —
# e.g. a memory-hungry daemon can raise GOMEMLIMIT in its own plist.
# Coordinates with the gopls shim envelope (ce-710r.7) rather than diverging.

# Soft memory limit for long-lived daemons (512MiB). The Go runtime runs the
# GC more aggressively as the heap approaches this ceiling, trading CPU for a
# bounded RSS instead of OOMing the host. Override per binary as needed.
GOMEMLIMIT=512MiB

# CPU parallelism cap. 0 (or any value < 1) leaves Go's default in place:
# GOMAXPROCS = runtime.NumCPU(). Set to a positive integer to cap CPU on
# shared hosts so one daemon can't starve the others.
GOMAXPROCS=0

# GC target percentage. 100 is the Go default (collect when heap doubles).
# Lower = less RSS, more CPU; higher (e.g. 200) = less CPU, more RSS.
GOGC=100
