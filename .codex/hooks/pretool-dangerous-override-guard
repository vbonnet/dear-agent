#!/usr/bin/env bash
# PreToolUse hook: dangerous overrides require a stated reason and a human approval.
#
# WHAT: denies a raw Codex --dangerously-bypass-hook-trust tool call. Only
# AGM's attested `session new` path may carry this flag; authorization without
# immutable hook attestation is not sufficient.
#
# WHY a block, not a nudge: these flags switch off a safety control. An agent
# that can set one unattended can silently disable the control and nobody finds
# out until the incident. The gates live in pkg/override; this hook is the
# tool-call-time surface of the same contract, so an agent shelling out to raw
# `codex --dangerously-bypass-hook-trust` cannot route around the AGM flag.
#
# Fails open (exit 0) on unparseable input, per CODEX-HOOK-05.
#
# HOW it blocks: Codex does not treat a non-zero hook exit as a refusal — it
# logs "PreToolUse Failed" and runs the tool anyway. A refusal must be a
# structured decision on stdout:
#   {"hookSpecificOutput":{"hookEventName":"PreToolUse",
#                          "permissionDecision":"deny",
#                          "permissionDecisionReason":"..."}}
# Exiting 2 alone is a no-op here, which is why deny() emits the wire form.
set -uo pipefail

input="$(cat)"
command -v jq >/dev/null 2>&1 || exit 0

# deny refuses the tool call in the form Codex actually honours.
deny() {
  jq -nc --arg reason "$1" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$reason}}'
  printf '%s\n' "$1" >&2
  exit 0
}

tool="$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null || true)"
[ "$tool" = "Bash" ] || exit 0

cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
[ -n "$cmd" ] || exit 0

# One narrow command language owns its authorization in AGM: an invocation of
# the installed `agm session new` command with the reason-bearing override
# flag. This is a positive allowlist, not a separator denylist. Every character,
# executable, subcommand, and required flag must match, so shell control
# operators, substitutions, redirections, globbing, and a second command can
# never enter the exception.
trusted_agm="$HOME/go/bin/agm"
resolved_agm="$(command -v agm 2>/dev/null || true)"
safe_command_pattern="^[[:alnum:]_./:=,+%@ '\"-]+$"
if [ "$resolved_agm" = "$trusted_agm" ] && [[ "$cmd" =~ $safe_command_pattern ]]; then
  case "$cmd" in
    "agm session new "*|"$trusted_agm session new "*)
      case "$cmd" in
        *" --dangerously-bypass-hook-trust="*) exit 0 ;;
      esac
      ;;
  esac
fi

# Project literal shell quoting and escaping before testing the denied argv.
# Bash concatenates quoted/unquoted runs into one argument, so checking only
# the raw spelling would miss e.g. --dangerously-bypass-hook-"trust". This
# projection never evaluates expansions or executes caller input. A raw Codex
# command containing an expansion is denied conservatively because its
# effective argv cannot be proven free of the bypass.
projected_cmd="${cmd//\\/}"
projected_cmd="${projected_cmd//\"/}"
projected_cmd="${projected_cmd//\'/}"
case "$projected_cmd" in
  *--dangerously-bypass-hook-trust*) ;;
  *codex*)
    case "$cmd" in
      *'$'*|*'`'*) ;;
      *) exit 0 ;;
    esac
    ;;
  *) exit 0 ;;
esac

deny "raw codex --dangerously-bypass-hook-trust is forbidden because it cannot prove immutable hook attestation. Use: $trusted_agm session new <name> --dangerously-bypass-hook-trust=<auditable-reason>"
