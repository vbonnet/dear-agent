#!/usr/bin/env bash
# PreToolUse hook: dangerous overrides require a stated reason and a human approval.
#
# WHAT: routes a raw Codex --dangerously-bypass-hook-trust tool call through
# AGM's shared authorization gate. Normal AGM commands authorize inside the
# binary; this hook covers the only native flag that could otherwise go around
# that binary.
#
# WHY a block, not a nudge: these flags switch off a safety control. An agent
# that can set one unattended can silently disable the control and nobody finds
# out until the incident. The gates live in pkg/override; this hook is the
# tool-call-time surface of the same contract, so an agent shelling out to raw
# `codex --dangerously-bypass-hook-trust` cannot route around the AGM flag.
#
# Fails open (exit 0) on unparseable input, per CODEX-HOOK-05.
#
# HOW it blocks: Codex does not treat a non-zero hook exit as a refusal — it
# logs "PreToolUse Failed" and runs the tool anyway. A refusal must be a
# structured decision on stdout:
#   {"hookSpecificOutput":{"hookEventName":"PreToolUse",
#                          "permissionDecision":"deny",
#                          "permissionDecisionReason":"..."}}
# Exiting 2 alone is a no-op here, which is why deny() emits the wire form.
set -uo pipefail

input="$(cat)"
command -v jq >/dev/null 2>&1 || exit 0

# deny refuses the tool call in the form Codex actually honours.
deny() {
  jq -nc --arg reason "$1" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$reason}}'
  printf '%s\n' "$1" >&2
  exit 0
}

tool="$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null || true)"
[ "$tool" = "Bash" ] || exit 0

cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
[ -n "$cmd" ] || exit 0

case "$cmd" in
  *--dangerously-bypass-hook-trust*) ;;
  *) exit 0 ;;
esac

# A single, unambiguous invocation of the installed AGM binary owns its own
# authorization. Do not record it twice in the hook. Compound commands are not
# accepted as this exception: `agm ...; codex --dangerously...` must take the
# raw path below.
trusted_agm="$HOME/go/bin/agm"
resolved_agm="$(command -v agm 2>/dev/null || true)"
simple_command=1
case "$cmd" in
  *";"*|*"&&"*|*"||"*|*"|"*|*'`'*|*'$('*|*$'\n'*) simple_command=0 ;;
esac
if [ "$simple_command" -eq 1 ] && [ "$resolved_agm" = "$trusted_agm" ]; then
  case "$cmd" in
    "agm "*|"$trusted_agm "*) exit 0 ;;
  esac
fi

# A raw Codex flag is boolean, so the justification cannot ride on the flag.
# The operator must place it in the parent Codex environment. A tool command
# cannot retroactively alter this hook's environment, which keeps the reason
# outside the unattended command being authorized.
reason="${AGM_CODEX_HOOK_TRUST_REASON:-}"
if [ -z "$reason" ]; then
  deny "raw codex --dangerously-bypass-hook-trust requires AGM_CODEX_HOOK_TRUST_REASON in the parent Codex environment. Stop and ask the operator to restart Codex with that auditable reason after running: $trusted_agm override approve codex-hook-trust --ttl 1h"
fi
if [ ! -x "$trusted_agm" ]; then
  deny "cannot authorize raw codex hook-trust bypass: trusted AGM binary is missing at $trusted_agm"
fi

auth_error="$("$trusted_agm" override authorize codex-hook-trust \
  --reason "$reason" --actor codex-pretool-hook 2>&1 >/dev/null)" || \
  deny "raw codex hook-trust override refused by the shared authorization gate: $auth_error"

exit 0
