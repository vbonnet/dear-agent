#!/usr/bin/env bash
# PreToolUse hook: block BEADS_DIR usage, redirect to bd --db or bd -C.
#
# bd (beads) supports two ways to target a database outside the current
# directory:
#
#   bd --db /path/to/.beads/embeddeddolt <cmd>   # explicit DB path
#   bd -C /path/to/project <cmd>                  # cd-style directory targeting
#
# BEADS_DIR is not a supported bd environment variable and has no effect on bd.
# Setting or dereferencing it only clutters the environment and misleads readers.
#
# Triggers on:
#   - Bash commands that assign (BEADS_DIR=...) or dereference ($BEADS_DIR)
#   - Write/Edit/MultiEdit on shell-like files containing the same patterns
#
# Fails OPEN: any parse error exits 0 — this hook must never wedge a session.

set -uo pipefail

MESSAGE='Use `bd --db <path>` or `bd -C <dir>` instead of BEADS_DIR.

BEADS_DIR is not a supported bd environment variable. Setting it has no
effect on bd and leaves dead weight in the environment.

To target a database outside the current directory, use one of:

  # Explicit DB path (find with `bd where` inside the project):
  bd --db /path/to/.beads/embeddeddolt list
  bd --db /path/to/.beads/embeddeddolt show ce-123

  # cd-style targeting (equivalent to running bd from inside the project):
  bd -C /path/to/project list
  bd -C /path/to/project show ce-123

bd also auto-discovers databases by walking up the directory tree, so
if you are already inside the project no flag is needed at all.'

# Assignment: BEADS_DIR=... or export BEADS_DIR=... — the leading
# (^|[^[:alnum:]_]) emulates a negative lookbehind so MY_BEADS_DIR passes.
ASSIGN_RE='(^|[^[:alnum:]_])BEADS_DIR[[:space:]]*='

# Dereference: $BEADS_DIR or ${BEADS_DIR} — trailing ([^[:alnum:]_]|$)
# emulates \b so $BEADS_DIRX passes.
DEREF_RE='\$\{?BEADS_DIR([^[:alnum:]_]|$)'

# Shell-like files that could embed env-var setup.
SHELL_FILE_RE='(\.(sh|bash|zsh|fish|env|envrc|profile)|/\.?(bashrc|zshrc|bash_profile|profile|envrc|env))$'

uses_beads_dir() {
  printf '%s' "$1" | grep -qE "$ASSIGN_RE" && return 0
  printf '%s' "$1" | grep -qE "$DEREF_RE" && return 0
  return 1
}

block() {
  printf '%s\n' "$MESSAGE" >&2
  exit 2
}

input="$(cat)"
tool="$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null || true)"
[ -n "$tool" ] || exit 0

case "$tool" in
Bash)
  cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
  [ -n "$cmd" ] || exit 0
  if uses_beads_dir "$cmd"; then
    block
  fi
  ;;
Write | Edit | MultiEdit)
  file_path="$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty' 2>/dev/null || true)"
  [ -n "$file_path" ] || exit 0
  printf '%s' "$file_path" | grep -qE "$SHELL_FILE_RE" || exit 0
  text="$(printf '%s' "$input" | jq -r '
    .tool_input as $t |
    [($t.content // empty), ($t.new_string // empty),
     (($t.edits // [])[] | .new_string // empty)] | join("\n")
  ' 2>/dev/null || true)"
  [ -n "$text" ] || exit 0
  if uses_beads_dir "$text"; then
    block
  fi
  ;;
esac

exit 0
