#!/bin/bash
# Stop / SubagentStop hook: the WF-A guardrail feedback loop (bead ce-vrux).
#
# WHAT: when an agent is about to finish, run the deterministic guardrail
# bundle (scripts/guardrail-bundle.sh — vet+build+lint today; Semgrep/arch
# tests via WF-B/WF-C tomorrow). If the bundle is RED, block the stop and feed
# *natural-language* remediation back into the live agent via the Stop-hook
# `{"decision":"block","reason":...}` contract, so it keeps working until the
# guardrails are green — the "keep going until green" loop. This is the
# keystone that lets every other guardrail close back into the agent on the
# laptop, as close to code-generation as possible, instead of in GitHub CI.
#
# WHY a block here, not a nudge (contrast pretool-spawn-routing): a failing
# guardrail at stop-time is the exact moment a human reviewer would have said
# "not done — fix this first." Surfacing it as additionalContext alone would
# let the agent stop on red. So we block — but with positive guidance
# (principle 2): the reason explains what failed, how to fix it, and how to
# bow out, never a bare "you can't stop."
#
# WHY it cannot wedge a session (principle 2 + anti-stall): three independent
# brakes — (1) the harness stop-hook continuation flag yields control back to
# the human after one blocked continuation; (2) it only acts when the working
# tree is dirty, so read-only / chat / planning turns are never touched; (3) it
# fails OPEN — any missing tool, unreadable input, non-repo cwd, or unwritable
# state exits 0 and lets the stop proceed. Opt out for a session with
# `export DEAR_GUARDRAIL_LOOP=0`.
#
# SCOPE (principle 1): WF-A owns the *loop mechanism* only. The guardrail
# *checks* live behind scripts/guardrail-bundle.sh and grow in WF-B/WF-C. This
# hook neither knows nor cares what the bundle runs.
set -uo pipefail

# --- fail-open preconditions -------------------------------------------------
# A hook-trust bypass must never turn a trusted Stop hook into an execution
# trampoline for mutable project code. Ordinary sessions retain the local
# feedback loop; bypassed sessions rely on explicit agent-run preflight and CI.
[ -z "${AGM_CODEX_HOOK_ROOT:-}" ] || exit 0

command -v jq >/dev/null 2>&1 || exit 0
hook_json() { jq "$@"; }
input="$(cat)"
[ -n "$input" ] || exit 0

# Global opt-out for an interactive session that doesn't want the loop.
[ "${DEAR_GUARDRAIL_LOOP:-1}" = "0" ] && exit 0

event="$(printf '%s' "$input" | hook_json -r '.hook_event_name // empty' 2>/dev/null || true)"
case "$event" in
  Stop|SubagentStop) ;;
  *) exit 0 ;;  # never fire on other events
esac

# Secondary loop brake: true when this stop was itself triggered by a prior
# stop-hook block.
stop_active="$(printf '%s' "$input" | hook_json -r '.stop_hook_active // false' 2>/dev/null || echo false)"
cwd="$(printf '%s' "$input" | hook_json -r '.cwd // empty' 2>/dev/null || true)"
[ -n "$cwd" ] || cwd="${CLAUDE_PROJECT_DIR:-$PWD}"

# Resolve the repo root from cwd; if it isn't a git repo, there is nothing to
# guard — fail open.
root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || exit 0

bundle="$root/scripts/guardrail-bundle.sh"
[ -f "$bundle" ] || exit 0

# Only act when the agent actually changed something. A clean tree means the
# guardrails have nothing to say about this turn.
[ -n "$(git -C "$root" status --porcelain 2>/dev/null)" ] || exit 0

# --- run the guardrail bundle ------------------------------------------------
out="$(cd "$root" && bash "$bundle" 2>&1)"; rc=$?

if [ "$rc" -eq 0 ]; then
  # Green: let the agent stop.
  exit 0
fi

# Red. Truncate the bundle output so the feedback prompt stays readable.
trimmed="$(printf '%s' "$out" | tail -c 4000)"
[ "$(printf '%s' "$out" | wc -c)" -gt 4000 ] && trimmed="...(earlier output trimmed)...
$trimmed"

emit_block() { # $1 = reason text -> block the stop, feed reason to the agent
  hook_json -cn --arg r "$1" '{decision:"block",reason:$r}'
  exit 0
}
emit_context() { # $1 = text -> non-blocking note, let the agent stop
  hook_json -cn --arg c "$1" --arg e "$event" \
    '{hookSpecificOutput:{hookEventName:$e,additionalContext:$c}}'
  exit 0
}

if [ "$stop_active" = "true" ]; then
  # The harness has already continued once because of this hook. Yield rather
  # than persist or reread mutable state and risk an unbounded loop.
  emit_context "Guardrails are still failing after one automated continuation, so the WF-A loop is yielding control rather than retrying further (anti-stall). The remaining failures are below — please resolve them or escalate before relying on this change.

${trimmed}"
fi

emit_block "GUARDRAILS FAILING — not done yet (WF-A stop-hook loop, first attempt).

You're about to finish, but the guardrail bundle is red. This is the same feedback a human reviewer would have given you, delivered on your laptop instead of in CI — fix it before stopping rather than shipping a known-red change.

${trimmed}

Do this:
  1. Read the failures above and fix the *root cause* — do not suppress, skip, or comment out the check to make it pass.
  2. Re-run locally to confirm green:  scripts/guardrail-bundle.sh   (or: make preflight)
  3. When it passes, finish normally — the loop will let you stop.

If a failure is a genuine false positive or truly out of scope for this task, state that explicitly in your next message and stop anyway: the harness continuation brake yields after one retry and will not wedge you. To disable it for this session: export DEAR_GUARDRAIL_LOOP=0"
