#!/bin/bash
# PreToolUse hook: dogfooding routing nudge (Beads ce-qgf, AGENTS.md §Dogfooding).
#
# WHAT: when a session running in dear-agent tries to spawn a NEW top-level
# agent session/task outside our own orchestration — a raw `claude` /
# `claude-code` / `cowork` CLI session, or a Cowork scheduled task — inject a
# positive reminder to route through AGM/VROOM instead. Every task not on
# AGM/VROOM is a missing data point for the self-improvement flywheel.
#
# WHY a nudge, not a block (principle 2 — "enforcement is positive guidance,
# not punishment"): this hook ONLY emits `additionalContext`. It never returns
# a `permissionDecision`, so it can neither block a call nor auto-approve one —
# the normal permission flow is untouched. It fails OPEN: any unparseable or
# unexpected input exits 0 silently, so it can never wedge a session.
#
# SCOPE (deliberately narrow — principle 1, no scope creep): only spawn vectors
# a session can actually observe. The in-session `Agent`/`Task` subagent tool is
# NOT matched on purpose — a subagent runs inside the parent AGM session, so it
# never escapes the mesh. Spawns that happen at the human/Desktop layer (opening
# Cowork by hand) are outside any in-session hook's reach; this is a best-effort
# net for the programmatic path, not a complete gate. See AGENTS.why.md.
set -uo pipefail

json_tool="/usr/local/libexec/dear-agent-codex-hook-json"
if [ -z "${AGM_CODEX_HOOK_ROOT:-}" ]; then
  json_tool="$(command -v jq 2>/dev/null || true)"
fi
[ -x "$json_tool" ] || exit 0

input="$(cat)"
tool="$(printf '%s' "$input" | "$json_tool" -r '.tool_name // empty' 2>/dev/null || true)"
[ -n "$tool" ] || exit 0

AGM_HELP='Route it through AGM so it feeds the self-improvement flywheel and lands in the VROOM decision trail: write the task to a unique temporary file, run `agm session new --workspace <workspace> --detached --prompt-file <path> <name>`, then remove the file after success or failure (or use `agm supervisor run` for governance-relevant multi-step work). See dear-agent AGENTS.md §Dogfooding. This is a reminder, not a block — your call proceeds normally.'

emit() { # $1 = guidance text -> additionalContext only, then allow normal flow
  "$json_tool" -cn --arg c "$1" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",additionalContext:$c}}'
  exit 0
}

case "$tool" in
  mcp__scheduled-tasks__create_scheduled_task)
    emit "You are creating a Cowork scheduled task outside AGM/VROOM. $AGM_HELP"
    ;;
  Bash)
    cmd="$(printf '%s' "$input" | "$json_tool" -r '.tool_input.command // empty' 2>/dev/null || true)"
    [ -n "$cmd" ] || exit 0
    # First real token of each simple command (split on ; | & newline), with
    # leading VAR=val env-assignments dropped and the path reduced to a basename.
    # `agm ...` is intentionally absent from the match set — it is the right path.
    bin="$(printf '%s' "$cmd" | tr ';|&\n' '\n\n\n\n' | awk '
      function base(p){ sub(/.*\//,"",p); return p }
      {
        c=""; nxt=""
        for (i=1; i<=NF; i++) {
          if (c=="" && $i ~ /=/) continue
          if (c=="") { c=base($i); continue }
          nxt=$i; break
        }
        if (c ~ /^(claude|claude-code|cowork)$/) {
          # Skip read-only/management subcommands — not a session spawn.
          if (nxt ~ /^(mcp|config|doctor|setup-token|update|install|migrate-installer|--version|-v|--help|-h)$/) next
          print c; exit
        }
      }')"
    [ -n "$bin" ] && emit "You are spawning a new agent session via \`$bin\` outside AGM/VROOM. $AGM_HELP"
    ;;
esac
exit 0
