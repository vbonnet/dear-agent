{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}/.codex/hooks/pretool-spawn-routing",
            "statusMessage": "Checking AGM/VROOM routing",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}/.codex/hooks/pretool-bead-close-guard",
            "statusMessage": "Checking bead Definition of Done",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "command": "${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}/.codex/hooks/pretool-beads-dir-block",
            "statusMessage": "Checking Beads database targeting",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}/.codex/hooks/pretool-bypass-guard",
            "statusMessage": "Checking for bypass flags",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}/.codex/hooks/pretool-pr-guard",
            "statusMessage": "Checking PR lifecycle compliance",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "go run \"${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}/cmd/spec-contract-hook\" --root \"${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\" --provider codex --event Stop",
            "statusMessage": "Checking staged SPEC contracts",
            "timeout": 60,
            "type": "command"
          },
          {
            "command": "${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}/.codex/hooks/stop-guardrail-feedback",
            "statusMessage": "Running guardrail feedback",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "go run \"${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}/cmd/spec-contract-hook\" --root \"${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\" --provider codex --event SubagentStop",
            "statusMessage": "Checking staged SPEC contracts",
            "timeout": 60,
            "type": "command"
          },
          {
            "command": "${AGM_CODEX_HOOK_ROOT:-${CLAUDE_PROJECT_DIR:-.}}/.codex/hooks/stop-guardrail-feedback",
            "statusMessage": "Running guardrail feedback",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "test -n \"${AGM_CODEX_HOOK_ROOT:-}\" || exec bd --db ~/beads/context-engine/.beads --dolt-auto-commit on codex-hook PostCompact",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "test -n \"${AGM_CODEX_HOOK_ROOT:-}\" || exec bd --db ~/beads/context-engine/.beads --dolt-auto-commit on codex-hook PreCompact",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "test -n \"${AGM_CODEX_HOOK_ROOT:-}\" || exec bd --db ~/beads/context-engine/.beads --dolt-auto-commit on codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "test -n \"${AGM_CODEX_HOOK_ROOT:-}\" || exec bd --db ~/beads/context-engine/.beads --dolt-auto-commit on codex-hook UserPromptSubmit",
            "statusMessage": "Refreshing Beads context",
            "type": "command"
          }
        ]
      }
    ]
  }
}
