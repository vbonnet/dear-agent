{
  "name": "engram-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Engram integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "engram-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "test:watch": "tsx --test --watch src/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "engram",
    "wayfinder",
    "claude"
  ],
  "author": "Engram Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "fast-uri": "3.1.5",
    "ip-address": "10.3.1"
  }
}
