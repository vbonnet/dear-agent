# Test: agm version should display version information
# This is a simple smoke test to verify the agm binary works

exec agm version
stdout 'version'

# Test: agm without arguments exits with an error in a non-interactive environment.
# Note: agm tries to start an interactive session which fails either with a TTY error
# or a database error. The cobra Usage block is intentionally silenced
# (rootCmd.SilenceUsage = true), so we assert the error is printed rather than usage.
! exec agm
stderr 'Error'
