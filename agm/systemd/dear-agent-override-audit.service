[Unit]
Description=Dear Agent dangerous-override audit
Documentation=https://github.com/vbonnet/dear-agent
After=default.target

[Service]
Type=oneshot
ExecStart=%h/go/bin/agm override audit --window 168h --threshold 5 --notify
WorkingDirectory=%h
Environment="HOME=%h"
Environment="PATH=%h/go/bin:/usr/local/bin:/usr/bin:/bin"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dear-agent-override-audit
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

