[Unit]
Description=Dear Agent dangerous-override audit for %i
Documentation=https://github.com/vbonnet/dear-agent
After=local-fs.target

[Service]
Type=oneshot
User=%i
ExecStart=/usr/local/libexec/dear-agent-override-audit --config /dev/null override audit --window 168h --threshold 5 --notify
WorkingDirectory=/
Environment="HOME=/"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dear-agent-override-audit
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
