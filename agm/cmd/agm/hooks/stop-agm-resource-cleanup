#!/bin/bash
# Claude Code hook: Clean up session resources on stop
# Triggered when Claude Code session ends (Stop event)
#
# Purpose: Remove git worktrees and branches left behind by the session.
# Four layers, all best-effort and non-blocking:
#
#   1. Manifest/Dolt cleanup ('agm session cleanup') — removes worktrees the
#      session explicitly tracked. Only fires for AGM/tmux sessions.
#   2. Filesystem reaper ('agm session reap-worktrees') — the safety net for
#      worktrees created by a raw 'git worktree add' that were never tracked
#      (root cause of the recurring sprawl). It removes a worktree ONLY when
#      it is clean, zero commits ahead of base, on a claude/ branch, under
#      ~/worktrees, and not the worktree this hook is running in. It runs
#      whether or not the session is AGM-tracked.
#   3. Cross-repo backfill sweep ('agm worktree sweep --execute') — runs in
#      the background (fire-and-forget) so it does not count against the
#      hook timeout. Reclaims merged worktrees across ALL repos under
#      ~/worktrees that Layers 1/2 structurally cannot reach (they are
#      single-repo or DB-scoped). Safe: only MERGED worktrees are removed.
#   4. Orphan process reaper ('agm session reap-orphans') — kills gopls and
#      agm-mcp-server processes reparented to PID 1 (their session died
#      abruptly without reaping them), which otherwise accumulate until the
#      machine swaps. Runs in the background. Safe: only PPID==1 orphans are
#      killed; any process with a live parent is left untouched.
#   5. Worker-session auto-archive ('agm session archive') — archives the
#      session record for a STOPPED worker-role session so 'agm session list'
#      stays clean without waiting for the next GC pass. Heavily guarded (see
#      the layer below); protected supervisor roles are never touched.
#
# Installation: Copy to ~/.claude/hooks/stop-agm-resource-cleanup
# Permissions: chmod +x ~/.claude/hooks/stop-agm-resource-cleanup

set -euo pipefail

# Layer 1: manifest/Dolt cleanup for AGM-tracked sessions only.
AGM_SESSION=$(tmux display-message -p '#S' 2>/dev/null || echo "")
if [ -n "$AGM_SESSION" ]; then
    agm session cleanup "$AGM_SESSION" 2>/dev/null || true
fi

# Layer 2: conservative filesystem reaper. Runs from the session's worktree
# (cwd); --repo defaults to cwd and the running worktree excludes itself.
# Best-effort: a failure here must never block session exit.
agm session reap-worktrees 2>/dev/null || true

# Layer 3: cross-repo backfill sweep (fire-and-forget, does not block exit).
# disown prevents SIGHUP from killing the child when the hook shell exits.
agm worktree sweep --execute >/dev/null 2>&1 &
disown $!

# Layer 4: orphan process reaper (fire-and-forget, does not block exit).
# Reaps gopls/agm-mcp-server reparented to PID 1 (session died abruptly).
agm session reap-orphans >/dev/null 2>&1 &
disown $!

# Layer 5: worker-session auto-archive. When a worker-role session has stopped
# (its Claude process exited and no live tmux pane remains), archive its session
# record so it drops out of 'agm session list' immediately instead of waiting
# for the next GC pass.
#
# Safety, in layers — each independently sufficient to prevent a wrong archive:
#   - Only fires for AGM/tmux-tracked sessions (needs a resolvable name).
#   - Skips protected supervisor roles (orchestrator/overseer/meta-) by name,
#     mirroring the supervisor-protection guard in ArchiveSession. Matched
#     case-insensitively, same as IsSupervisorSession.
#   - Only fires when the manifest carries the 'role:worker' tag — never for
#     untagged, non-worker, or unknown-role sessions.
#   - Only archives when status is 'stopped' (no live tmux pane). A mid-session
#     Stop event reports 'active' and is skipped, so interactive worker sessions
#     are never archived between turns.
#   - Archive runs WITHOUT --force, so ArchiveSession's checkActiveTmuxBlock,
#     completion verification, and pending-delegation guards all still apply.
#     The tmux-pane match those guards rely on was unified in ce-cxjb.1, which
#     is what makes this no-force path safe to add.
#   - Entirely best-effort: any failure is swallowed and never blocks exit.
#
# Note: we read the role from the manifest (via 'agm session get') rather than
# from env vars — AGM only sets AGM_SESSION_NAME in the Claude environment, not
# a role or UUID, so an env-based check would silently never fire.
if [ -n "$AGM_SESSION" ]; then
    agm_session_lc=$(printf '%s' "$AGM_SESSION" | tr '[:upper:]' '[:lower:]')
    case "$agm_session_lc" in
        *orchestrator*|*overseer*|*meta-*)
            : # protected supervisor role — never auto-archive
            ;;
        *)
            session_json=$(agm session get "$AGM_SESSION" -o json 2>/dev/null || echo "")
            if [ -n "$session_json" ] \
                && printf '%s' "$session_json" | jq -e '(.tags // []) | index("role:worker")' >/dev/null 2>&1 \
                && [ "$(printf '%s' "$session_json" | jq -r '.status // ""' 2>/dev/null)" = "stopped" ]; then
                agm session archive "$AGM_SESSION" >/dev/null 2>&1 || true
            fi
            ;;
    esac
fi

exit 0
