#!/usr/bin/env bash
#
# Git post-merge hook — two fail-safe stages that fire after a merge/pull lands
# on the repo's DEFAULT branch:
#
#   Stage 1 — rebuild affected Go binaries (this repo only).
#     After a PR lands on main, the `agm` / `vroom-dispatch` binaries in
#     ~/go/bin are stale until someone remembers to `go install`. This stage
#     closes that gap: it inspects what changed in the merge and reinstalls
#     ONLY the binaries whose source actually changed. Docs/tests/config-only
#     merges rebuild nothing (near-instant no-op). Crucially, it ALWAYS builds
#     from the freshly-fetched origin/<default_branch> (via a throwaway detached
#     worktree), never from whatever ref this local checkout sits on — so the
#     installed binary's vcs.revision is provably trunk. See `fetch_trunk_commit`
#     / `ensure_build_dir` and `rebuild_changed_binaries`. (Jun-18 retro B2,
#     ce-11u3: agm was rebuilt from a 4-day-stale ancestor not on origin/main.)
#
#   Stage 2 — reap provably-merged worktrees via `agm worktree sweep --execute`.
#     The reaper itself already exists and is fail-safe (it removes ONLY worktrees
#     that are provably MERGED *and* clean). We do NOT reimplement any of that
#     here — see agm/internal/ops/worktree_sweep.go. This stage only pulls the
#     trigger. See `sweep_merged_worktrees`.
#
# Why one hook, two stages: both are triggered by the exact same event — a PR
# landing on the default branch locally — and both must be inert everywhere
# else. Sharing the default-branch gate keeps that contract in one place.
#
# Scope: this hook is GLOBAL (installed via core.hooksPath / chezmoi), so it
# runs after every merge in every repo. Each stage therefore self-scopes:
#   • Stage 1 acts only in a repo that actually contains the target binary
#     packages (today, that is dear-agent). Every other repo is a silent no-op.
#   • Stage 2 acts only when `agm` is installed and the ~/worktrees workflow is
#     in use.
#
# Safety / etiquette (positive guidance — why each guard exists):
#   • Only acts on the DEFAULT branch. A feature-branch integration merge
#     ("git merge main" while on a feature branch) must NOT trigger either stage.
#   • NEVER blocks or fails the git operation — always exits 0. A convenience
#     (rebuild / cleanup) must never get in the way of the merge that triggered
#     it. A failed `go install` is reported and skipped, not fatal.
#   • Stage 1 runs in the FOREGROUND so "Rebuilding agm…" is visible in the
#     terminal you just ran `git pull` in. Stage 2 runs DETACHED + file-logged
#     so the merge returns immediately.
#   • Per-invocation timeout on the sweep so a hung `gh` PR-state probe can never
#     wedge the merge.
#
# Opt-outs (per stage):
#   DEAR_AGENT_POST_MERGE_REBUILD=0   skip Stage 1 (binary rebuild)
#   AGM_POST_MERGE_SWEEP=0            skip Stage 2 (worktree sweep)
#
# Test seam: AGM_POST_MERGE_SWEEP_SYNC=1 runs the sweep in the foreground
# (deterministic for tests; also handy if you want `git pull` to wait).
#
# Install: `make install-post-merge-hook` (honours core.hooksPath and never
# clobbers a chezmoi-managed hooks dir — see cmd/install-post-merge-hook).

set -u

# ── Resolve the repo's default branch (origin/HEAD, else local main/master) ─
default_branch=""
if ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"; then
  default_branch="${ref#origin/}"
fi
if [ -z "${default_branch}" ]; then
  for cand in main master; do
    if git show-ref --verify --quiet "refs/heads/${cand}"; then
      default_branch="${cand}"
      break
    fi
  done
fi

current_branch="$(git branch --show-current 2>/dev/null)"

# Only act when the merge landed on the default branch (a PR hitting main).
if [ -z "${default_branch}" ] || [ "${current_branch}" != "${default_branch}" ]; then
  exit 0
fi

# ── Stage 1: rebuild affected Go binaries ──────────────────────────────────
#
# The binary manifest. Each entry is a Go package path (relative to the repo
# root) followed by the source-tree prefixes whose changes can affect that
# binary. A trailing "/" marks a directory prefix; a bare token (go.mod/go.sum)
# is matched exactly. `go install` is cache-friendly on its own — it relinks
# only when inputs changed — but we additionally gate on the diff so we don't
# even invoke `go` on a docs/tests/config-only merge.
#
#   agm             ./agm/cmd/agm       ← agm/ pkg/ internal/ go.mod go.sum
#   vroom-dispatch  ./cmd/vroom-dispatch ← cmd/vroom-dispatch/ pkg/ internal/ go.mod go.sum

# is_build_relevant: a changed file that cannot affect a compiled binary
# (markdown, test files) is ignored even when it sits under a source prefix.
# docs/ and .github/ are excluded automatically — they are under no binary's
# prefixes.
is_build_relevant() {
  case "$1" in
    *_test.go) return 1 ;;
    *.md)      return 1 ;;
  esac
  return 0
}

# under_prefix <file> <prefix...>: true if <file> is under any directory prefix
# (token ending in "/") or equals any exact token (go.mod / go.sum).
under_prefix() {
  _f="$1"
  shift
  for _p in "$@"; do
    case "${_p}" in
      */) case "${_f}" in "${_p}"*) return 0 ;; esac ;;
      *)  [ "${_f}" = "${_p}" ] && return 0 ;;
    esac
  done
  return 1
}

# maybe_rebuild <pkg-path> <prefix...>: reinstall the binary built from
# <pkg-path> iff a build-relevant changed file falls under one of its prefixes
# (or the diff could not be determined — then rebuild to be safe). Sets
# rebuilt_any=1 on a successful install. Never fatal.
maybe_rebuild() {
  _pkg="$1"
  shift
  _name="$(basename "${_pkg}")"

  # Self-scope: only a repo that actually contains this package gets touched.
  [ -d "${repo_root}/${_pkg}" ] || return 0

  _affected=0
  _trigger=""
  if [ "${indeterminate}" = "1" ]; then
    _affected=1
    _trigger="could not determine diff — rebuilding to be safe"
  else
    # Feed the file list via `printf` + process substitution rather than an
    # unquoted here-doc: the variable is quoted (no expansion of its contents)
    # and the loop runs in the current shell so _affected/_trigger persist.
    while IFS= read -r _f; do
      [ -n "${_f}" ] || continue
      is_build_relevant "${_f}" || continue
      if under_prefix "${_f}" "$@"; then
        _affected=1
        [ -z "${_trigger}" ] && _trigger="$(dirname "${_f}")/"
      fi
    done < <(printf '%s\n' "${changed}")
  fi

  [ "${_affected}" = "1" ] || return 0

  # Resolve WHERE to build from. Never `go install` the local working tree
  # directly: its embedded vcs.revision is whatever ref this checkout/worktree
  # happens to sit on, which on Jun-18 was a 4-day-stale ancestor (0fd2ee23)
  # that was not on origin/main. ensure_build_dir hands back a throwaway
  # detached worktree pinned to the freshly-fetched origin/<default_branch>, so
  # the installed binary's revision is provably trunk. It falls back to the
  # in-place working tree only when there is no origin trunk ref (local-only
  # repos / this hook's own tests).
  ensure_build_dir

  echo "[post-merge:rebuild] Rebuilding ${_name} (source changed in ${_trigger})..." >&2
  if ( cd "${build_dir}" && GOBIN="${HOME}/go/bin" go install "./${_pkg}" ); then
    echo "[post-merge:rebuild] ✓ installed ${_name} -> ${HOME}/go/bin/${_name}" >&2
    rebuilt_any=1
  else
    echo "[post-merge:rebuild] ✗ ${_name} rebuild FAILED — git op unaffected." >&2
    echo "[post-merge:rebuild]   rebuild manually: (cd ${repo_root} && go install ./${_pkg})" >&2
  fi
}

# _pick_timeout: echo the first available timeout wrapper (gtimeout on macOS
# coreutils, then GNU timeout), or nothing if neither exists. Used to cap the
# trunk fetch so a hung network probe can never wedge the merge.
_pick_timeout() {
  for _t in gtimeout timeout; do
    if command -v "${_t}" >/dev/null 2>&1; then
      printf '%s' "${_t}"
      return 0
    fi
  done
}

# fetch_trunk_commit: best-effort fetch of origin/<default_branch> and resolve
# its commit into build_commit. The freshly-fetched trunk HEAD is the ONLY
# legitimate source for the binary that gets run — see the Jun-18 incident
# (ce-11u3 / retro B2). Never fatal: no origin remote (local-only repos and
# this hook's tests) or an offline fetch simply leaves build_commit empty, and
# the build falls back to the working tree in place.
fetch_trunk_commit() {
  build_commit=""
  git -C "${repo_root}" remote get-url origin >/dev/null 2>&1 || return 0

  _to="$(_pick_timeout)"
  if [ -n "${_to}" ]; then
    "${_to}" 60 git -C "${repo_root}" fetch --quiet origin "${default_branch}" 2>/dev/null || true
  else
    git -C "${repo_root}" fetch --quiet origin "${default_branch}" 2>/dev/null || true
  fi

  build_commit="$(git -C "${repo_root}" rev-parse --verify --quiet "origin/${default_branch}^{commit}" 2>/dev/null || true)"
}

# ensure_build_dir: lazily resolve build_dir — the directory `go install` runs
# in. Preference: a throwaway detached worktree checked out at build_commit
# (origin/<default_branch>), so the binary's vcs.revision is provably trunk
# regardless of this checkout's ref. Falls back to the in-place working tree
# when build_commit is empty or the worktree cannot be created. Idempotent:
# resolves once, the worktree (if any) is reaped by cleanup_build_dir.
ensure_build_dir() {
  [ -n "${build_dir}" ] && return 0

  if [ -n "${build_commit}" ]; then
    _tmp_parent="$(mktemp -d 2>/dev/null || true)"
    if [ -n "${_tmp_parent}" ]; then
      _wt="${_tmp_parent}/build"
      if git -C "${repo_root}" worktree add --quiet --detach "${_wt}" "${build_commit}" 2>/dev/null; then
        build_dir="${_wt}"
        build_worktree="${_wt}"
        echo "[post-merge:rebuild] Building from origin/${default_branch} @ $(git -C "${repo_root}" rev-parse --short "${build_commit}" 2>/dev/null)" >&2
        return 0
      fi
      rm -rf "${_tmp_parent}" 2>/dev/null || true
    fi
    echo "[post-merge:rebuild] could not check out origin/${default_branch}; building working tree in place" >&2
  fi

  build_dir="${repo_root}"
}

# cleanup_build_dir: remove the throwaway build worktree (if one was created).
# Best-effort; never fatal.
cleanup_build_dir() {
  [ -n "${build_worktree}" ] || return 0
  git -C "${repo_root}" worktree remove --force "${build_worktree}" 2>/dev/null || true
  rm -rf "$(dirname "${build_worktree}")" 2>/dev/null || true
  build_dir=""
  build_worktree=""
}

rebuild_changed_binaries() {
  [ "${DEAR_AGENT_POST_MERGE_REBUILD:-1}" = "0" ] && return 0

  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0

  # Scope the global hook: if neither binary package exists in this repo, this
  # is not dear-agent — stay completely silent.
  any_target=0
  for _pkg in agm/cmd/agm cmd/vroom-dispatch; do
    [ -d "${repo_root}/${_pkg}" ] && any_target=1
  done
  [ "${any_target}" = "1" ] || return 0

  if ! command -v go >/dev/null 2>&1; then
    echo "[post-merge:rebuild] go not found on PATH — skipping binary rebuild" >&2
    return 0
  fi

  # What changed in the merge/pull that just completed. ORIG_HEAD is set by
  # `git merge`/`git pull` to the pre-merge tip and is the most reliable
  # baseline; HEAD@{1} is the reflog fallback (matches the documented
  # `git diff HEAD@{1} HEAD` form). If neither resolves, treat the diff as
  # indeterminate and rebuild (cheap — the build cache makes a no-change
  # rebuild a fast relink).
  range=""
  if git rev-parse --verify --quiet ORIG_HEAD >/dev/null 2>&1; then
    range="ORIG_HEAD HEAD"
  elif git rev-parse --verify --quiet 'HEAD@{1}' >/dev/null 2>&1; then
    range="HEAD@{1} HEAD"
  fi

  indeterminate=0
  changed=""
  if [ -n "${range}" ]; then
    # shellcheck disable=SC2086  # range is two refs, intentional word-split.
    if ! changed="$(git diff --name-only ${range} 2>/dev/null)"; then
      # The baseline resolved but the diff itself failed (shallow clone missing
      # the parent object, repo corruption). Don't silently skip the rebuild —
      # treat it as indeterminate and rebuild to be safe.
      indeterminate=1
    fi
  else
    indeterminate=1
  fi

  # Fetch the canonical trunk commit up front (once). build_dir/build_worktree
  # are resolved lazily by ensure_build_dir on the first actual rebuild, so a
  # docs/tests/config-only merge never pays the worktree-creation cost.
  build_dir=""
  build_worktree=""
  fetch_trunk_commit

  rebuilt_any=0
  maybe_rebuild "agm/cmd/agm"        agm/ pkg/ internal/ go.mod go.sum
  maybe_rebuild "cmd/vroom-dispatch" cmd/vroom-dispatch/ pkg/ internal/ go.mod go.sum
  cleanup_build_dir

  if [ "${indeterminate}" != "1" ] && [ "${rebuilt_any}" = "0" ]; then
    echo "[post-merge:rebuild] No binary rebuild needed (docs/tests/config only)." >&2
  fi
}

# ── Stage 1.5: verify the rebuilt binary is actually on origin/main ─────────
# A merge landing on the default branch is only Definition-of-Done if the
# binary that gets *run* contains the merged code. The Jun-18 ghost-text
# incident (ce-mb9g) was a binary built from a rolled-back checkout (a commit
# NOT on origin/main) that silently kept making safety decisions. This stage
# asserts the freshly-installed `agm`'s embedded vcs.revision is an ancestor of
# origin/main and warns LOUDLY otherwise. Like the rest of this hook it NEVER
# fails the git operation — it only surfaces the problem.
#   Opt-out: DEAR_AGENT_POST_MERGE_VERIFY=0
verify_deployment_after_rebuild() {
  [ "${DEAR_AGENT_POST_MERGE_VERIFY:-1}" = "0" ] && return 0
  command -v agm >/dev/null 2>&1 || return 0

  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  # Self-scope: only the repo that builds agm. Every other repo is a no-op.
  [ -d "${repo_root}/agm/cmd/agm" ] || return 0

  # Clear the hook's GIT_* env so agm's own `git -C <repo>` calls operate on the
  # source repo, not this hook's repo context.
  if env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
      agm admin verify-deployment --repo "${repo_root}" --ref origin/main >/dev/null 2>&1; then
    echo "[post-merge:verify] ✓ installed agm is on origin/main" >&2
  else
    echo "[post-merge:verify] ====================================================" >&2
    echo "[post-merge:verify] ⚠ DEPLOY-VERIFY: rebuilt agm is NOT on origin/main!" >&2
    echo "[post-merge:verify]   The running binary may have been built from a" >&2
    echo "[post-merge:verify]   rolled-back or divergent checkout. Details:" >&2
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
      agm admin verify-deployment --repo "${repo_root}" --ref origin/main >&2 2>&1 || true
    echo "[post-merge:verify]   Fix: rebuild from a clean origin/main checkout." >&2
    echo "[post-merge:verify] ====================================================" >&2
  fi
}

# ── Stage 2: reap provably-merged worktrees ────────────────────────────────
sweep_merged_worktrees() {
  [ "${AGM_POST_MERGE_SWEEP:-1}" = "0" ] && return 0
  command -v agm >/dev/null 2>&1 || return 0

  log_dir="${HOME}/.claude/logs"
  mkdir -p "${log_dir}" 2>/dev/null || true
  log_file="${log_dir}/worktree-post-merge.log"
  ts="$(date -u +%FT%TZ 2>/dev/null || echo unknown)"

  printf '[%s] post-merge on %s: launching `agm worktree sweep --execute`\n' \
    "${ts}" "${default_branch}" >> "${log_file}" 2>/dev/null || true

  # Prefer gtimeout (macOS coreutils) then timeout; run bare if neither exists.
  timeout_bin=""
  for t in gtimeout timeout; do
    if command -v "$t" >/dev/null 2>&1; then
      timeout_bin="$t"
      break
    fi
  done

  # run_sweep executes the canonical reaper with a per-invocation timeout. The
  # GIT_* hook env is cleared so the sweep operates on the repos it discovers
  # under ~/worktrees, not on this hook's repo context.
  run_sweep() {
    if [ -n "${timeout_bin}" ]; then
      env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
        "${timeout_bin}" 120 agm worktree sweep --execute
    else
      env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
        agm worktree sweep --execute
    fi
  }

  if [ "${AGM_POST_MERGE_SWEEP_SYNC:-0}" = "1" ]; then
    run_sweep >> "${log_file}" 2>&1
  else
    # Detach so the merge/pull returns immediately; the sweep is fail-safe and
    # self-logging.
    run_sweep >> "${log_file}" 2>&1 &
  fi
}

# ── Run the stages (each self-scopes and is individually fail-safe) ─────────
rebuild_changed_binaries
verify_deployment_after_rebuild
sweep_merged_worktrees

exit 0
