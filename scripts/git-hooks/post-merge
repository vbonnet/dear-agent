#!/usr/bin/env bash
#
# Git post-merge hook — three fail-safe stages that fire after a merge/pull lands
# on the repo's DEFAULT branch:
#
#   Stage 1 — rebuild affected Go binaries (this repo only).
#     After a PR lands on main, the `agm` / `agm-reaper` / `vroom-dispatch` /
#     `wayfinder` binaries in ~/go/bin are stale until someone remembers to
#     `go install`. This stage
#     closes that gap: it inspects what changed in the merge and reinstalls
#     ONLY the binaries whose source actually changed. Docs/tests/config-only
#     merges rebuild nothing (near-instant no-op). Crucially, it ALWAYS builds
#     from the freshly-fetched origin/<default_branch> (via a throwaway detached
#     worktree), never from whatever ref this local checkout sits on — so the
#     installed binary's vcs.revision is provably trunk. See `fetch_trunk_commit`
#     / `ensure_build_dir` and `rebuild_changed_binaries`. (Jun-18 retro B2,
#     ce-11u3: agm was rebuilt from a 4-day-stale ancestor not on origin/main.)
#
#   Stage 1.6 — deploy host artifacts via `dear-deploy sync` (this repo only).
#     Stage 1 keeps the `go install` binaries in ~/go/bin current, but the repo
#     also ships HOST artifacts whose source of truth is deploy/manifest.yaml:
#     the mergeloop launchd plist (~/Library/LaunchAgents) and the compiled
#     PreToolUse write-guard hooks (~/.config/claude-code/hooks). Those were
#     never auto-deployed — they drifted until someone ran `make dear-deploy-sync`
#     by hand. This stage closes that gap declaratively: instead of hand-coding a
#     per-artifact diff, it shells out to `dear-deploy sync`, which reads the
#     manifest and rewrites only the artifacts that have actually drifted (each
#     through the principle-9 stage→verify→activate sequence). It builds + syncs
#     from the SAME trunk worktree Stage 1 uses, so the deployed write-guards and
#     plist are provably origin/<default_branch> — never a divergent local ref,
#     and never written into the read-only ~/src checkout. See `deploy_host_artifacts`.
#     (Design: deploy-worker-vroom Phase 2 — Component 3; ce-snsu / ce-gzfv.)
#     NOTE: dear-deploy is a FILE deployer — Go binaries (agm/vroom-dispatch) are
#     status-only there (ce-12fp), so Stage 1's rebuild is NOT folded into it.
#
#   Stage 2 — reap provably-merged worktrees via `agm worktree sweep --execute`.
#     The reaper itself already exists and is fail-safe (it removes ONLY worktrees
#     that are provably MERGED *and* clean). We do NOT reimplement any of that
#     here — see agm/internal/ops/worktree_sweep.go. This stage only pulls the
#     trigger. See `sweep_merged_worktrees`.
#
#   Stage 3 — transition merged beads to CLOSED in the context-engine Beads DB.
#     safe-pr folds a Definition-of-Done close line — "Closes ce-xxxx" (also
#     Fixes/Resolves) — into the PR body. That line is a GitHub convention, but
#     the bead lives in a local Beads DB, not on GitHub, so the merge never
#     actually moves it. This stage closes that gap: it reads the closing-keyword
#     references out of the just-merged commits and runs `bd close` on each, so a
#     merged PR leaves its tracking bead CLOSED without a human round-trip. See
#     `transition_merged_beads`.
#
# Why one hook, two stages: both are triggered by the exact same event — a PR
# landing on the default branch locally — and both must be inert everywhere
# else. Sharing the default-branch gate keeps that contract in one place.
#
# Scope: this hook is GLOBAL (installed via core.hooksPath / chezmoi), so it
# runs after every merge in every repo — including throwaway repositories a
# test suite creates. It therefore refuses outright in any repository outside
# the managed roots (see the managed-repository gate below), and each stage
# additionally self-scopes:
#   • Stage 1 acts only in a repo that actually contains the target binary
#     packages (today, that is dear-agent). Every other repo is a silent no-op.
#   • Stage 1.6 acts only in a repo that carries deploy/manifest.yaml (dear-agent).
#   • Stage 2 acts only when `agm` is installed and the ~/worktrees workflow is
#     in use.
#
# Safety / etiquette (positive guidance — why each guard exists):
#   • Only acts on the DEFAULT branch. A feature-branch integration merge
#     ("git merge main" while on a feature branch) must NOT trigger either stage.
#   • NEVER blocks or fails the git operation — always exits 0. A convenience
#     (rebuild / cleanup) must never get in the way of the merge that triggered
#     it. A failed `go install` is reported and skipped, not fatal.
#   • Stage 1 runs in the FOREGROUND so "Rebuilding agm…" is visible in the
#     terminal you just ran `git pull` in. Stage 2 runs DETACHED + file-logged
#     so the merge returns immediately.
#   • Per-invocation timeout on the sweep so a hung `gh` PR-state probe can never
#     wedge the merge.
#
# Opt-outs (per stage):
#   DEAR_AGENT_POST_MERGE_REBUILD=0           skip Stage 1 (binary rebuild)
#   DEAR_AGENT_POST_MERGE_VERIFY=0            skip Stage 1.5 (deploy verify)
#   DEAR_AGENT_POST_MERGE_DEPLOY=0            skip Stage 1.6 (host-artifact deploy)
#   AGM_POST_MERGE_SWEEP=0                    skip Stage 2 (worktree sweep)
#   DEAR_AGENT_POST_MERGE_BEAD_TRANSITION=0   skip Stage 3 (bead transition)
#
# Scope control:
#   DEAR_AGENT_MANAGED_REPO_ROOTS   colon-separated roots this hook may act in
#                                   (default: ~/src:~/worktrees). A repository
#                                   outside every root is a complete no-op.
#
# Test seams: AGM_POST_MERGE_SWEEP_SYNC=1 runs the sweep in the foreground
# (deterministic for tests; also handy if you want `git pull` to wait).
# DEAR_AGENT_BEADS_DB overrides the Beads DB path Stage 3 transitions against.
#
# Install: `make install-post-merge-hook` (honours core.hooksPath and never
# clobbers a chezmoi-managed hooks dir — see cmd/install-post-merge-hook).

set -u

# ── Managed-repository gate ────────────────────────────────────────────────
#
# This hook is installed globally (core.hooksPath), so it fires after a merge
# in EVERY repository on this host — including throwaway repositories created
# by test suites. On 2026-07-10 that is exactly what happened: two temporary
# repositories created by a plain `go test ./...` merged a branch, ran this
# hook, and launched two `agm worktree sweep --execute` processes that deleted
# two live worktrees (audit finding F-01, bead ce-3knl.1).
#
# The default-branch gate below does not catch that case: a temporary repo
# initialized with `-b main` is sitting on its default branch. Nor do the
# per-stage self-scoping checks — Stage 2 asks only whether `agm` is on PATH,
# and a repository-wide sweep does not care which repo triggered it.
#
# So every host-mutating stage runs only in a repository this host explicitly
# manages: a checkout under ~/src or ~/worktrees, or under a root named in
# DEAR_AGENT_MANAGED_REPO_ROOTS (colon-separated; it REPLACES the defaults
# rather than extending them, so a test can scope the hook to its own sandbox).
# Every other repository is a silent, complete no-op.
#
# This is opt-in by construction. An opt-out variable would not have prevented
# the incident: the temp repos did not know to set one.

# path_within <path> <root>: true when <path> is <root> or lies beneath it.
# Compares whole path components, so ~/src does not match ~/src-scratch.
path_within() {
  case "$1" in
    "$2") return 0 ;;
    "$2"/*) return 0 ;;
  esac
  [ "$2" = / ] && case "$1" in /*) return 0 ;; esac
  return 1
}

# real_path <path>: <path> with symlinks resolved, empty when unresolvable.
# macOS reports $TMPDIR as /var/folders/... while the real path is
# /private/var/folders/..., so an unresolved prefix comparison would let a
# temp repo pass a check against a resolved root (or fail one against an
# unresolved root).
real_path() {
  ( cd "$1" 2>/dev/null && pwd -P ) 2>/dev/null || true
}

is_managed_repo() {
  _top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  [ -n "${_top}" ] || return 1
	_top="$(real_path "${_top}")"
	[ -n "${_top}" ] || return 1
	# Every enabled stage below expands HOME. A caller-supplied root scopes the
	# repository set but cannot make a sanitized hook environment safe.
	[ -n "${HOME:-}" ] || return 1

	_roots="${DEAR_AGENT_MANAGED_REPO_ROOTS:-}"
	if [ -z "${_roots}" ]; then
		# A globally installed hook can run in a sanitized environment. Without
		# HOME there is no safe default managed-root set, so leave the checkout
		# alone rather than failing under set -u.
		_roots="${HOME}/src:${HOME}/worktrees"
	fi
  _rest="${_roots}"
  while [ -n "${_rest}" ]; do
    case "${_rest}" in
      *:*) _root="${_rest%%:*}"; _rest="${_rest#*:}" ;;
      *)   _root="${_rest}";     _rest="" ;;
    esac
    [ -n "${_root}" ] || continue
    _real_root="$(real_path "${_root}")"
    [ -n "${_real_root}" ] || continue
    if path_within "${_top}" "${_real_root}"; then
      return 0
    fi
  done
  return 1
}

if ! is_managed_repo; then
  exit 0
fi

# ── Resolve the repo's default branch (origin/HEAD, else local main/master) ─
default_branch=""
if ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"; then
  default_branch="${ref#origin/}"
fi
if [ -z "${default_branch}" ]; then
  for cand in main master; do
    if git show-ref --verify --quiet "refs/heads/${cand}"; then
      default_branch="${cand}"
      break
    fi
  done
fi

current_branch="$(git branch --show-current 2>/dev/null)"

# Only act when the merge landed on the default branch (a PR hitting main).
if [ -z "${default_branch}" ] || [ "${current_branch}" != "${default_branch}" ]; then
  exit 0
fi

# ── Stage 1: rebuild affected Go binaries ──────────────────────────────────
#
# The binary manifest. Each entry is a Go package path (relative to the repo
# root) followed by the source-tree prefixes whose changes can affect that
# binary. A trailing "/" marks a directory prefix; a bare token (go.mod/go.sum)
# is matched exactly. `go install` is cache-friendly on its own — it relinks
# only when inputs changed — but we additionally gate on the diff so we don't
# even invoke `go` on a docs/tests/config-only merge.
#
#   agm + reaper    ./agm/cmd/{agm,agm-reaper} ← agm/ pkg/ internal/ go.mod go.sum
#   vroom-dispatch  ./cmd/vroom-dispatch ← cmd/vroom-dispatch/ pkg/ internal/ go.mod go.sum
#   wayfinder       ./wayfinder/cmd/wayfinder ← wayfinder/ pkg/ internal/ go.mod go.sum

# is_build_relevant: a changed file that cannot affect a compiled binary
# (markdown, test files) is ignored even when it sits under a source prefix.
# docs/ and .github/ are excluded automatically — they are under no binary's
# prefixes.
is_build_relevant() {
  case "$1" in
    *_test.go) return 1 ;;
    *.md)      return 1 ;;
  esac
  return 0
}

# under_prefix <file> <prefix...>: true if <file> is under any directory prefix
# (token ending in "/") or equals any exact token (go.mod / go.sum).
under_prefix() {
  _f="$1"
  shift
  for _p in "$@"; do
    case "${_p}" in
      */) case "${_f}" in "${_p}"*) return 0 ;; esac ;;
      *)  [ "${_f}" = "${_p}" ] && return 0 ;;
    esac
  done
  return 1
}

# resolve_build_trigger <prefix...>: set _affected/_trigger for the current
# changed-file set. Keeping this decision in one helper ensures serialized and
# ordinary rebuild paths classify the same source boundary.
resolve_build_trigger() {
  _affected=0
  _trigger=""
  if [ "${indeterminate}" = "1" ]; then
    _affected=1
    _trigger="could not determine diff — rebuilding to be safe"
    return 0
  fi
  while IFS= read -r _f; do
    [ -n "${_f}" ] || continue
    is_build_relevant "${_f}" || continue
    if under_prefix "${_f}" "$@"; then
      _affected=1
      [ -z "${_trigger}" ] && _trigger="$(dirname "${_f}")/"
    fi
  done < <(printf '%s\n' "${changed}")
}

# maybe_rebuild <pkg-path> <prefix...>: reinstall the binary built from
# <pkg-path> iff a build-relevant changed file falls under one of its prefixes
# (or the diff could not be determined — then rebuild to be safe). Sets
# rebuilt_any=1 on a successful install. Never fatal.
maybe_rebuild() {
  _pkg="$1"
  shift
  _name="$(basename "${_pkg}")"

  # Self-scope: only a repo that actually contains this package gets touched.
  [ -d "${repo_root}/${_pkg}" ] || return 0

  resolve_build_trigger "$@"

  [ "${_affected}" = "1" ] || return 0

  # Resolve WHERE to build from. Never `go install` the local working tree
  # directly: its embedded vcs.revision is whatever ref this checkout/worktree
  # happens to sit on, which on Jun-18 was a 4-day-stale ancestor (0fd2ee23)
  # that was not on origin/main. ensure_build_dir hands back a throwaway
  # detached worktree pinned to the freshly-fetched origin/<default_branch>, so
  # the installed binary's revision is provably trunk. It falls back to the
  # in-place working tree only when there is no origin trunk ref (local-only
  # repos / this hook's own tests).
  ensure_build_dir

  echo "[post-merge:rebuild] Rebuilding ${_name} (source changed in ${_trigger})..." >&2

  # ATOMIC install: build to a temp file in GOBIN, then rename() it over the
  # target on the same filesystem. `go install` (like any in-place overwrite)
  # truncates and rewrites the SAME inode, so macOS SIGKILLs every running
  # instance whose mapped Mach-O changed underneath it ("Code Signature
  # Invalid" — the 2026-07-06 crash loop, ce-w77v). A rename leaves the old
  # inode intact for live processes until they exit, so redeploying a running
  # binary can never crash it. Build source is ${build_dir} (ensure_build_dir's
  # origin/<default_branch>-pinned checkout), not the local working tree.
  _gobin="${GOBIN:-${HOME}/go/bin}"
  mkdir -p "${_gobin}" 2>/dev/null || true
  _tmp="${_gobin}/.${_name}.install.$$"
  if ( cd "${build_dir}" && go build -o "${_tmp}" "./${_pkg}" ); then
    if mv -f "${_tmp}" "${_gobin}/${_name}"; then
      echo "[post-merge:rebuild] ✓ installed ${_name} -> ${_gobin}/${_name} (atomic)" >&2
      rebuilt_any=1
    else
      rm -f "${_tmp}" 2>/dev/null || true
      echo "[post-merge:rebuild] ✗ ${_name} atomic install (rename) FAILED — git op unaffected." >&2
    fi
  else
    rm -f "${_tmp}" 2>/dev/null || true
    echo "[post-merge:rebuild] ✗ ${_name} rebuild FAILED — git op unaffected." >&2
    echo "[post-merge:rebuild]   rebuild manually: (cd ${repo_root} && go build -o ${_gobin}/${_name} ./${_pkg})" >&2
  fi
}

# run_install_lock <path> <timeout-seconds> <label> <internal-mode>: run a
# narrow rebuild subprocess under a shared kernel-released lock. GNU/BSD flock
# and macOS lockf have different CLIs, so both use their portable
# file-and-command form rather than pretending macOS lockf accepts an open fd.
run_install_lock() {
  _install_lock_path="$1"
  _install_lock_timeout="$2"
  _install_lock_label="$3"
  _install_lock_mode="$4"
  case "${_install_lock_timeout}" in ''|*[!0-9]*) _install_lock_timeout=300 ;; esac
  _install_lock_tool="${DEAR_AGENT_INSTALL_LOCK_TOOL:-auto}"
  _install_command=(env "DEAR_AGENT_POST_MERGE_INTERNAL_MODE=${_install_lock_mode}" DEAR_AGENT_POST_MERGE_REBUILD=1 bash "$0")

  if { [ "${_install_lock_tool}" = "auto" ] || [ "${_install_lock_tool}" = "flock" ]; } && command -v flock >/dev/null 2>&1; then
    flock -w "${_install_lock_timeout}" "${_install_lock_path}" "${_install_command[@]}"
    return $?
  fi
  if { [ "${_install_lock_tool}" = "auto" ] || [ "${_install_lock_tool}" = "lockf" ]; } && command -v lockf >/dev/null 2>&1; then
    lockf -t "${_install_lock_timeout}" "${_install_lock_path}" "${_install_command[@]}"
    return $?
  fi
  echo "[post-merge:rebuild] neither compatible flock nor lockf is available for ${_install_lock_label} deployment." >&2
  return 1
}

# prepare_agm_pair_lock migrates directories left by the retired PID-directory
# protocol before the advisory lock opens the same path as a regular file.
prepare_agm_pair_lock() {
  _pair_lock_timeout="${AGM_PAIR_LOCK_TIMEOUT_SECONDS:-300}"
  case "${_pair_lock_timeout}" in ''|*[!0-9]*) _pair_lock_timeout=300 ;; esac

  # Migrate a lock directory left by the previous PID-directory protocol. An
  # ownerless/malformed directory is safe to remove with rmdir (which fails if
  # any unexpected entry appears); a live legacy owner gets the same bounded
  # wait as the advisory lock below. If we remove the directory during the old
  # mkdir/write gap, that owner fails its PID write and leaves the pair intact.
  _pair_legacy_wait=0
  while [ -d "${_pair_lock}" ]; do
    _pair_legacy_owner="$(cat "${_pair_lock}/pid" 2>/dev/null || true)"
    case "${_pair_legacy_owner}" in ''|*[!0-9]*) _pair_legacy_owner="" ;; esac
    if [ -z "${_pair_legacy_owner}" ] || ! kill -0 "${_pair_legacy_owner}" 2>/dev/null; then
      rm -f "${_pair_lock}/pid" 2>/dev/null || true
      rmdir "${_pair_lock}" 2>/dev/null || return 1
      break
    fi
    [ "${_pair_legacy_wait}" -lt "${_pair_lock_timeout}" ] || return 1
    sleep 1
    _pair_legacy_wait=$((_pair_legacy_wait + 1))
  done

  return 0
}

# maybe_rebuild_agm_pair serializes pair deployment across every checkout that
# shares GOBIN. Every affected contender waits, reacquires, refreshes canonical
# trunk, and installs that latest revision rather than deferring a newer merge.
maybe_rebuild_agm_pair() {
  agm_pair_handled=0
  [ -d "${repo_root}/agm/cmd/agm" ] || return 0
  [ -d "${repo_root}/agm/cmd/agm-reaper" ] || return 0
  resolve_build_trigger agm/ pkg/ internal/ go.mod go.sum
  [ "${_affected}" = "1" ] || return 0
  agm_pair_handled=1

  _pair_gobin="${GOBIN:-${HOME}/go/bin}"
  mkdir -p "${_pair_gobin}" 2>/dev/null || true
  _pair_lock="${_pair_gobin}/.agm-pair-install.lock"
  if prepare_agm_pair_lock && run_install_lock "${_pair_lock}" "${_pair_lock_timeout}" "AGM pair" "agm-pair"; then
    rebuilt_any=1
  else
    echo "[post-merge:rebuild] AGM pair locked deployment failed — installed pair unchanged." >&2
  fi

  # A contender may have waited while trunk advanced. Refresh the parent hook's
  # build context before it considers the remaining managed binaries.
  cleanup_build_dir
  build_dir=""
  build_worktree=""
  fetch_trunk_commit
  return 0
}

# resolve_agm_pair_provenance derives one complete development profile from the
# pinned source. It publishes no partial profile when either source fact is
# unavailable.
resolve_agm_pair_provenance() {
  local _resolved_revision _resolved_build_date _helper_build_date _helper_ldflags _spec_hook_tmp _expected_spec_hook_hash

  _resolved_revision="$(git -C "${build_dir}" rev-parse --short=12 HEAD 2>/dev/null || true)"
  # Git lengthens --short=12 when twelve characters are not unique. Preserve
  # that signal by rejecting the governed 12-character profile rather than
  # truncating a unique abbreviation back into ambiguity.
  [ "${#_resolved_revision}" -eq 12 ] || return 1
  case "${_resolved_revision}" in *[!0-9a-f]*) return 1 ;; esac

  _resolved_build_date="$(
    TZ=UTC git -C "${build_dir}" show -s --format=%cd \
      --date=format-local:%Y-%m-%dT%H:%M:%SZ HEAD 2>/dev/null || true
  )"
  [ -n "${_resolved_build_date}" ] || return 1

  # Mirror Make's default build-spec-contract-hook stamp exactly. This source
  # is a fresh detached checkout, so its default buildstamp GitCommit is the
  # already admitted clean short revision; BuildDate intentionally preserves
  # the commit's RFC3339 offset (`%cI`), as Make does.
  _helper_build_date="$(git -C "${build_dir}" show -s --format=%cI HEAD 2>/dev/null || true)"
  [ -n "${_helper_build_date}" ] || return 1
  _helper_ldflags="-X github.com/vbonnet/dear-agent/pkg/version.Version=dev -X github.com/vbonnet/dear-agent/pkg/version.GitCommit=${_resolved_revision} -X github.com/vbonnet/dear-agent/pkg/version.BuildDate=${_helper_build_date} -X github.com/vbonnet/dear-agent/pkg/version.BuiltBy=makefile"

  # AGM's unattended Codex projection admits only the root-installed helper
  # whose digest was compiled into AGM. Build that helper from the same pinned
  # detached revision as the pair, with the governed helper's reproducibility
  # boundary, before staging either installed binary. A later privileged helper
  # install is therefore required to match this exact source revision.
  _spec_hook_tmp="$(mktemp "${TMPDIR:-/tmp}/dear-agent-spec-contract-hook.XXXXXX")" || return 1
  if ! (
    cd "${build_dir}" &&
      CGO_ENABLED=0 GOWORK=off go build -trimpath -buildvcs=false \
        -ldflags "${_helper_ldflags}" -o "${_spec_hook_tmp}" ./cmd/spec-contract-hook
  ); then
    rm -f "${_spec_hook_tmp}" 2>/dev/null || true
    return 1
  fi
  _expected_spec_hook_hash="$(/usr/bin/openssl dgst -sha256 -r "${_spec_hook_tmp}" 2>/dev/null || true)"
  _expected_spec_hook_hash="${_expected_spec_hook_hash%% *}"
  rm -f "${_spec_hook_tmp}" 2>/dev/null || true
  [ "${#_expected_spec_hook_hash}" -eq 64 ] || return 1
  case "${_expected_spec_hook_hash}" in *[!0-9a-f]*) return 1 ;; esac

  _pair_ldflags="-X github.com/vbonnet/dear-agent/pkg/version.Version=dev-${_resolved_revision} -X github.com/vbonnet/dear-agent/pkg/version.GitCommit=${_resolved_revision} -X github.com/vbonnet/dear-agent/pkg/version.BuildDate=${_resolved_build_date} -X github.com/vbonnet/dear-agent/pkg/version.BuiltBy=post-merge-hook -X github.com/vbonnet/dear-agent/agm/internal/codexhooks.expectedSpecContractHookSHA256=${_expected_spec_hook_hash}"
}

# maybe_rebuild_agm_pair_locked stages the CLI and detached archive companion
# while the shared install lock is held. Neither installed binary is touched
# unless both builds succeed.
maybe_rebuild_agm_pair_locked() {
  agm_pair_handled=0
  [ -d "${repo_root}/agm/cmd/agm" ] || return 0
  [ -d "${repo_root}/agm/cmd/agm-reaper" ] || return 0

  resolve_build_trigger agm/ pkg/ internal/ go.mod go.sum

  [ "${_affected}" = "1" ] || return 0
  agm_pair_handled=1

  # The hook may have waited behind an older merge. Refresh origin/main only
  # after acquiring the lock so the last contender cannot reinstall an older
  # ancestor over a newer coherent pair.
  fetch_trunk_commit
  if ! ensure_agm_pair_build_dir; then
    echo "[post-merge:rebuild] ✗ cannot create an immutable detached AGM pair source — check source HEAD and git worktree availability; installed pair unchanged." >&2
    return 0
  fi

  if ! resolve_agm_pair_provenance; then
    echo "[post-merge:rebuild] ✗ cannot resolve complete AGM pair provenance from pinned source — check its revision and commit timestamp; installed pair unchanged." >&2
    return 0
  fi

  _gobin="${GOBIN:-${HOME}/go/bin}"
  mkdir -p "${_gobin}" 2>/dev/null || true
  _agm_tmp="${_gobin}/.agm.install.$$.pair"
  _reaper_tmp="${_gobin}/.agm-reaper.install.$$.pair"
  _agm_target="${_gobin}/agm"
  _reaper_target="${_gobin}/agm-reaper"
  _agm_backup="${_gobin}/.agm.rollback.$$.pair"
  _reaper_backup="${_gobin}/.agm-reaper.rollback.$$.pair"
  _had_agm=0
  _had_reaper=0

  echo "[post-merge:rebuild] Staging agm + agm-reaper (source changed in ${_trigger})..." >&2
  if ! ( cd "${build_dir}" && CGO_ENABLED=0 GOWORK=off go build -trimpath -buildvcs=false -ldflags "${_pair_ldflags}" -o "${_agm_tmp}" ./agm/cmd/agm ); then
    rm -f "${_agm_tmp}" "${_reaper_tmp}" 2>/dev/null || true
    echo "[post-merge:rebuild] ✗ agm pair staging FAILED — installed pair unchanged." >&2
    return 0
  fi
  if ! ( cd "${build_dir}" && CGO_ENABLED=0 GOWORK=off go build -trimpath -buildvcs=false -ldflags "${_pair_ldflags}" -o "${_reaper_tmp}" ./agm/cmd/agm-reaper ); then
    rm -f "${_agm_tmp}" "${_reaper_tmp}" 2>/dev/null || true
    echo "[post-merge:rebuild] ✗ agm-reaper pair staging FAILED — installed pair unchanged." >&2
    return 0
  fi

  if [ -e "${_agm_target}" ]; then
    _had_agm=1
    ln "${_agm_target}" "${_agm_backup}" 2>/dev/null || cp -p "${_agm_target}" "${_agm_backup}" 2>/dev/null || {
      rm -f "${_agm_tmp}" "${_reaper_tmp}" "${_agm_backup}" 2>/dev/null || true
      echo "[post-merge:rebuild] ✗ could not stage agm rollback — installed pair unchanged." >&2
      return 0
    }
  fi
  if [ -e "${_reaper_target}" ]; then
    _had_reaper=1
    ln "${_reaper_target}" "${_reaper_backup}" 2>/dev/null || cp -p "${_reaper_target}" "${_reaper_backup}" 2>/dev/null || {
      rm -f "${_agm_tmp}" "${_reaper_tmp}" "${_agm_backup}" "${_reaper_backup}" 2>/dev/null || true
      echo "[post-merge:rebuild] ✗ could not stage agm-reaper rollback — installed pair unchanged." >&2
      return 0
    }
  fi

  if ! mv -f "${_agm_tmp}" "${_agm_target}"; then
    rm -f "${_agm_tmp}" "${_reaper_tmp}" "${_agm_backup}" "${_reaper_backup}" 2>/dev/null || true
    echo "[post-merge:rebuild] ✗ agm pair activation FAILED — installed pair unchanged." >&2
    return 0
  fi
  if ! mv -f "${_reaper_tmp}" "${_reaper_target}"; then
    if [ "${_had_agm}" = "1" ]; then
      mv -f "${_agm_backup}" "${_agm_target}" 2>/dev/null || true
    else
      rm -f "${_agm_target}" 2>/dev/null || true
    fi
    if [ "${_had_reaper}" = "1" ]; then
      mv -f "${_reaper_backup}" "${_reaper_target}" 2>/dev/null || true
    fi
    rm -f "${_agm_tmp}" "${_reaper_tmp}" "${_agm_backup}" "${_reaper_backup}" 2>/dev/null || true
    echo "[post-merge:rebuild] ✗ agm-reaper pair activation FAILED — prior pair restored." >&2
    return 0
  fi

  rm -f "${_agm_backup}" "${_reaper_backup}" 2>/dev/null || true
  rebuilt_any=1
  echo "[post-merge:rebuild] ✓ installed agm + agm-reaper as one revision-coherent pair (atomic files)" >&2
}

# maybe_rebuild_wayfinder serializes Wayfinder activation across checkouts that
# share GOBIN. A contender refreshes canonical trunk only after acquiring the
# lock, preventing an older, slower build from replacing a newer installation.
maybe_rebuild_wayfinder() {
  [ -d "${repo_root}/wayfinder/cmd/wayfinder" ] || return 0
  resolve_build_trigger wayfinder/ pkg/ internal/ go.mod go.sum
  [ "${_affected}" = "1" ] || return 0

  _wayfinder_gobin="${GOBIN:-${HOME}/go/bin}"
  mkdir -p "${_wayfinder_gobin}" 2>/dev/null || true
  _wayfinder_lock="${_wayfinder_gobin}/.wayfinder-install.lock"
  _wayfinder_lock_timeout="${WAYFINDER_LOCK_TIMEOUT_SECONDS:-300}"
  if run_install_lock "${_wayfinder_lock}" "${_wayfinder_lock_timeout}" "Wayfinder" "wayfinder"; then
    rebuilt_any=1
  else
    echo "[post-merge:rebuild] Wayfinder locked deployment failed — installed binary unchanged." >&2
  fi

  # Keep later targets on a trunk revision no older than the locked install.
  cleanup_build_dir
  build_dir=""
  build_worktree=""
  fetch_trunk_commit
  return 0
}

# _pick_timeout: echo the first available timeout wrapper (gtimeout on macOS
# coreutils, then GNU timeout), or nothing if neither exists. Used to cap the
# trunk fetch so a hung network probe can never wedge the merge.
_pick_timeout() {
  for _t in gtimeout timeout; do
    if command -v "${_t}" >/dev/null 2>&1; then
      printf '%s' "${_t}"
      return 0
    fi
  done
}

# fetch_trunk_commit: best-effort fetch of origin/<default_branch> and resolve
# its commit into build_commit. Freshly resolved trunk is preferred for every
# build — see the Jun-18 incident (ce-11u3 / retro B2). Never fatal: no origin
# remote or unresolved remote ref leaves build_commit empty. Generic targets
# may then use their historical in-place fallback; the AGM pair separately
# pins local HEAD into an immutable detached checkout.
fetch_trunk_commit() {
  build_commit=""
  git -C "${repo_root}" remote get-url origin >/dev/null 2>&1 || return 0

  _to="$(_pick_timeout)"
  if [ -n "${_to}" ]; then
    "${_to}" 60 git -C "${repo_root}" fetch --quiet origin "${default_branch}" 2>/dev/null || true
  else
    git -C "${repo_root}" fetch --quiet origin "${default_branch}" 2>/dev/null || true
  fi

  build_commit="$(git -C "${repo_root}" rev-parse --verify --quiet "origin/${default_branch}^{commit}" 2>/dev/null || true)"
}

# create_detached_build_dir checks out build_commit into a disposable worktree.
# Callers choose whether failure may fall back to mutable source.
create_detached_build_dir() {
  local _source_label="$1" _tmp_parent _wt

  [ -n "${build_commit}" ] || return 1
  _tmp_parent="$(mktemp -d 2>/dev/null || true)"
  [ -n "${_tmp_parent}" ] || return 1
  _wt="${_tmp_parent}/build"
  if ! git -C "${repo_root}" worktree add --quiet --detach "${_wt}" "${build_commit}" 2>/dev/null; then
    rm -rf "${_tmp_parent}" 2>/dev/null || true
    return 1
  fi

  build_dir="${_wt}"
  build_worktree="${_wt}"
  echo "[post-merge:rebuild] Building from ${_source_label} @ $(git -C "${repo_root}" rev-parse --short "${build_commit}" 2>/dev/null)" >&2 || true
  return 0
}

# ensure_build_dir lazily resolves the directory a generic build runs in.
# Generic targets retain the historical in-place fallback when canonical trunk
# is unavailable or a disposable worktree cannot be created.
ensure_build_dir() {
  [ -n "${build_dir}" ] && return 0

  if [ -n "${build_commit}" ]; then
    if create_detached_build_dir "origin/${default_branch}"; then
      return 0
    fi
    echo "[post-merge:rebuild] could not check out origin/${default_branch}; building working tree in place" >&2
  fi

  build_dir="${repo_root}"
}

# ensure_agm_pair_build_dir makes immutability an admission requirement for
# the coherent pair. Without origin trunk it pins local HEAD once, but it never
# builds either artifact from the mutable in-place checkout.
ensure_agm_pair_build_dir() {
  local _pair_source_label

  [ -n "${build_dir}" ] && [ -n "${build_worktree}" ] && return 0
  [ -z "${build_dir}" ] || return 1

  _pair_source_label="origin/${default_branch}"
  if [ -z "${build_commit}" ]; then
    build_commit="$(git -C "${repo_root}" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null || true)"
    [ -n "${build_commit}" ] || return 1
    _pair_source_label="local HEAD"
  fi
  create_detached_build_dir "${_pair_source_label}"
}

# cleanup_build_dir: remove the throwaway build worktree (if one was created).
# Best-effort; never fatal.
cleanup_build_dir() {
  [ -n "${build_worktree}" ] || return 0
  git -C "${repo_root}" worktree remove --force "${build_worktree}" 2>/dev/null || true
  rm -rf "$(dirname "${build_worktree}")" 2>/dev/null || true
  build_dir=""
  build_worktree=""
}

rebuild_changed_binaries() {
  [ "${DEAR_AGENT_POST_MERGE_REBUILD:-1}" = "0" ] && return 0

  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0

  # Scope the global hook: if neither binary package exists in this repo, this
  # is not dear-agent — stay completely silent.
  any_target=0
  for _pkg in agm/cmd/agm agm/cmd/agm-reaper cmd/vroom-dispatch wayfinder/cmd/wayfinder; do
    [ -d "${repo_root}/${_pkg}" ] && any_target=1
  done
  [ "${any_target}" = "1" ] || return 0

  if ! command -v go >/dev/null 2>&1; then
    echo "[post-merge:rebuild] go not found on PATH — skipping binary rebuild" >&2
    return 0
  fi

  # What changed in the merge/pull that just completed. ORIG_HEAD is set by
  # `git merge`/`git pull` to the pre-merge tip and is the most reliable
  # baseline; HEAD@{1} is the reflog fallback (matches the documented
  # `git diff HEAD@{1} HEAD` form). If neither resolves, treat the diff as
  # indeterminate and rebuild (cheap — the build cache makes a no-change
  # rebuild a fast relink).
  range=""
  if git rev-parse --verify --quiet ORIG_HEAD >/dev/null 2>&1; then
    range="ORIG_HEAD HEAD"
  elif git rev-parse --verify --quiet 'HEAD@{1}' >/dev/null 2>&1; then
    range="HEAD@{1} HEAD"
  fi

  indeterminate=0
  changed=""
  if [ -n "${range}" ]; then
    # shellcheck disable=SC2086  # range is two refs, intentional word-split.
    if ! changed="$(git diff --name-only ${range} 2>/dev/null)"; then
      # The baseline resolved but the diff itself failed (shallow clone missing
      # the parent object, repo corruption). Don't silently skip the rebuild —
      # treat it as indeterminate and rebuild to be safe.
      indeterminate=1
    fi
  else
    indeterminate=1
  fi

  # Lock tools execute a narrow child copy of this hook using their native
  # file-and-command form. The child recomputes the merge diff, refreshes trunk
  # while the lock is held, installs exactly one target, and exits before any
  # deploy, Beads, or sweep side effects.
  if [ "${DEAR_AGENT_POST_MERGE_INTERNAL_MODE:-}" = "agm-pair" ]; then
    build_dir=""
    build_worktree=""
    rebuilt_any=0
    maybe_rebuild_agm_pair_locked
    cleanup_build_dir
    [ "${rebuilt_any}" = "1" ]
    return $?
  fi
  if [ "${DEAR_AGENT_POST_MERGE_INTERNAL_MODE:-}" = "wayfinder" ]; then
    build_dir=""
    build_worktree=""
    rebuilt_any=0
    fetch_trunk_commit
    maybe_rebuild "wayfinder/cmd/wayfinder" wayfinder/ pkg/ internal/ go.mod go.sum
    cleanup_build_dir
    [ "${rebuilt_any}" = "1" ]
    return $?
  fi

  # Fetch the canonical trunk commit up front (once). build_dir/build_worktree
  # are resolved lazily by ensure_build_dir on the first actual rebuild, so a
  # docs/tests/config-only merge never pays the worktree-creation cost.
  build_dir=""
  build_worktree=""
  fetch_trunk_commit

  rebuilt_any=0
  maybe_rebuild_agm_pair
  if [ "${agm_pair_handled}" != "1" ]; then
    maybe_rebuild "agm/cmd/agm"        agm/ pkg/ internal/ go.mod go.sum
    maybe_rebuild "agm/cmd/agm-reaper" agm/cmd/agm-reaper/ agm/internal/ pkg/ internal/ go.mod go.sum
  fi
  maybe_rebuild "cmd/vroom-dispatch" cmd/vroom-dispatch/ pkg/ internal/ go.mod go.sum
  maybe_rebuild_wayfinder
  # Self-update the deploy tool: keep ~/go/bin/dear-deploy current so on-demand /
  # Orchestrator invocations (Layer 2, ce-33sy) run trunk. Stage 1.6 below does
  # not depend on this — it builds dear-deploy from the trunk worktree itself —
  # this only makes the binary available on PATH outside the hook.
  maybe_rebuild "cmd/dear-deploy"    cmd/dear-deploy/ internal/deploy/ go.mod go.sum
  cleanup_build_dir

  if [ "${indeterminate}" != "1" ] && [ "${rebuilt_any}" = "0" ]; then
    echo "[post-merge:rebuild] No binary rebuild needed (docs/tests/config only)." >&2
  fi
}

# ── Stage 1.6: deploy host artifacts via dear-deploy sync ──────────────────
# Stage 1 rebuilds the `go install` binaries; this stage deploys the HOST
# artifacts declared in deploy/manifest.yaml — the mergeloop launchd plist and
# the compiled PreToolUse write-guard hooks — to their installed locations.
#
# Instead of a hand-coded per-artifact diff (the pattern Stage 1 still needs for
# `go install` targets), this stage delegates entirely to `dear-deploy sync`: it
# reads the manifest and rewrites only artifacts that have actually drifted, each
# through the principle-9 stage→verify→activate sequence (ADR-031, no bypass).
# `dear-deploy` is a FILE deployer — Go binaries are status-only there (ce-12fp,
# "deploying a binary means build + go install, not a file copy") — so Stage 1's
# rebuild is deliberately NOT folded in here.
#
# Build + sync run from the SAME throwaway origin/<default_branch> worktree Stage
# 1 builds in (ce-11u3 invariant): the deployed write-guards/plist are provably
# trunk, never a divergent local ref, and the build never writes into the
# read-only ~/src checkout. `make dear-deploy-sync` builds dear-deploy + the
# write-guards first, then runs `./bin/dear-deploy sync` (cwd = the worktree, so
# the manifest and its sources resolve there; deployed paths still use $HOME).
#   Opt-out: DEAR_AGENT_POST_MERGE_DEPLOY=0
deploy_host_artifacts() {
  [ "${DEAR_AGENT_POST_MERGE_DEPLOY:-1}" = "0" ] && return 0

  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  # Self-scope: only the repo that carries the deploy manifest (dear-agent).
  # Every other repo is a silent no-op, exactly like Stage 1.
  [ -f "${repo_root}/deploy/manifest.yaml" ] || return 0

  if ! command -v go >/dev/null 2>&1; then
    echo "[post-merge:deploy] go not found on PATH — skipping host-artifact deploy" >&2
    return 0
  fi
  if ! command -v make >/dev/null 2>&1; then
    echo "[post-merge:deploy] make not found on PATH — skipping host-artifact deploy" >&2
    return 0
  fi

  # Resolve the trunk build context. Stage 1 already fetches the canonical
  # trunk commit into build_commit; reuse it here so one post-merge run performs
  # at most one network fetch. If Stage 1 was skipped or found no trunk ref,
  # fetch lazily and then fall back to the working tree when still empty.
  build_dir=""
  build_worktree=""
  if [ -z "${build_commit:-}" ]; then
    fetch_trunk_commit
  fi
  ensure_build_dir

  echo "[post-merge:deploy] Deploying host artifacts (plist + write-guards) via dear-deploy sync..." >&2
  if ( cd "${build_dir}" && make dear-deploy-sync ) 1>&2; then
    echo "[post-merge:deploy] ✓ host artifacts in sync with deploy/manifest.yaml" >&2
  else
    echo "[post-merge:deploy] ✗ dear-deploy sync FAILED — git op unaffected." >&2
    echo "[post-merge:deploy]   deploy manually: (cd ${repo_root} && make dear-deploy-sync)" >&2
  fi

  cleanup_build_dir
}

# ── Stage 1.5: verify the rebuilt binary is actually on origin/main ─────────
# A merge landing on the default branch is only Definition-of-Done if the
# binary that gets *run* contains the merged code. The Jun-18 ghost-text
# incident (ce-mb9g) was a binary built from a rolled-back checkout (a commit
# NOT on origin/main) that silently kept making safety decisions. This stage
# asserts the freshly-installed `agm`'s embedded vcs.revision is an ancestor of
# origin/main and warns LOUDLY otherwise. Like the rest of this hook it NEVER
# fails the git operation — it only surfaces the problem.
#   Opt-out: DEAR_AGENT_POST_MERGE_VERIFY=0
verify_deployment_after_rebuild() {
  [ "${DEAR_AGENT_POST_MERGE_VERIFY:-1}" = "0" ] && return 0
  command -v agm >/dev/null 2>&1 || return 0

  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  # Self-scope: only the repo that builds agm. Every other repo is a no-op.
  [ -d "${repo_root}/agm/cmd/agm" ] || return 0

  # Clear the hook's GIT_* env so agm's own `git -C <repo>` calls operate on the
  # source repo, not this hook's repo context.
  if env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
      agm admin verify-deployment --repo "${repo_root}" --ref origin/main >/dev/null 2>&1; then
    echo "[post-merge:verify] ✓ installed agm is on origin/main" >&2
  else
    echo "[post-merge:verify] ====================================================" >&2
    echo "[post-merge:verify] ⚠ DEPLOY-VERIFY: rebuilt agm is NOT on origin/main!" >&2
    echo "[post-merge:verify]   The running binary may have been built from a" >&2
    echo "[post-merge:verify]   rolled-back or divergent checkout. Details:" >&2
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
      agm admin verify-deployment --repo "${repo_root}" --ref origin/main >&2 2>&1 || true
    echo "[post-merge:verify]   Fix: rebuild from a clean origin/main checkout." >&2
    echo "[post-merge:verify] ====================================================" >&2
  fi
}

# ── Stage 3: transition merged beads to closed ──────────────────────────────
# safe-pr injects a Definition-of-Done close line into the PR body — "Closes
# ce-xxxx" (also Fixes/Resolves; see cmd/safe-pr). That is a GitHub convention,
# but a bead lives in the context-engine Beads DB, not on GitHub, so the merge
# never actually moves it. This stage reads those closing-keyword references out
# of the just-merged commits and runs `bd close` on each, so a merged PR leaves
# its tracking bead CLOSED without a human round-trip.
#
# Why closing-keywords only (not a bare "(ce-xxxx)" subject mention): the
# subject tag marks the bead a commit *implements*, but an epic or a parent bead
# is often merely referenced in passing. Mirroring GitHub's own close-on-merge
# semantics — act ONLY on an explicit Closes/Fixes/Resolves — keeps the hook
# from auto-closing beads that were only mentioned.
#
# Scope/safety (why each guard exists):
#   • dear-agent only — the one repo whose work context-engine tracks. Every
#     other repo (this is a global hook) is a silent no-op.
#   • No-op without `bd` on PATH or without the canonical Beads DB present.
#   • Idempotent: a bead already CLOSED, or one absent from this store (a
#     cross-store id), is skipped — never re-closed, never errored on.
#   • NEVER forces (`bd close` without --force) and NEVER fails the git op —
#     a close that trips a gate is logged and skipped, not fatal.
#   Opt-out: DEAR_AGENT_POST_MERGE_BEAD_TRANSITION=0
#   Test seam: DEAR_AGENT_BEADS_DB overrides the DB path.
transition_merged_beads() {
  [ "${DEAR_AGENT_POST_MERGE_BEAD_TRANSITION:-1}" = "0" ] && return 0
  command -v bd >/dev/null 2>&1 || return 0

  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  # Self-scope: only the dear-agent repo, whose work context-engine tracks.
  [ -d "${repo_root}/agm/cmd/agm" ] || return 0

  beads_db="${DEAR_AGENT_BEADS_DB:-${HOME}/beads/context-engine/.beads}"
  [ -e "${beads_db}" ] || return 0

  # The commit range the merge/pull just introduced (same baseline as Stage 1).
  _range=""
  if git rev-parse --verify --quiet ORIG_HEAD >/dev/null 2>&1; then
    _range="ORIG_HEAD..HEAD"
  elif git rev-parse --verify --quiet 'HEAD@{1}' >/dev/null 2>&1; then
    _range="HEAD@{1}..HEAD"
  else
    return 0
  fi

  # Pull bead ids out of explicit GitHub-style closing keywords only. Two-step
  # grep: the first keeps only "<keyword> ce-id" spans, the second lifts the
  # bare id out of each. Bead ids look like ce-p8k1 or ce-6as.80 (sub-parts).
  # The (^|[^[:alpha:]]) prefix anchors the keyword on a word boundary so a
  # longer word ending in a keyword — "prefixes", "discloses" — can't false-
  # match (POSIX bracket class, portable across BSD/GNU grep; no \b).
  # shellcheck disable=SC2086  # _range is a single rev-range token.
  beads="$(git log --format='%B' ${_range} 2>/dev/null \
    | grep -ioE '(^|[^[:alpha:]])(close[sd]?|fix(es|ed)?|resolve[sd]?)[: ]+ce-[a-z0-9]+(\.[0-9]+)*' \
    | grep -ioE 'ce-[a-z0-9]+(\.[0-9]+)*' \
    | tr 'A-Z' 'a-z' \
    | sort -u)"
  [ -n "${beads}" ] || return 0

  _log_dir="${HOME}/.claude/logs"
  mkdir -p "${_log_dir}" 2>/dev/null || true
  _log_file="${_log_dir}/bead-transition-post-merge.log"
  _ts="$(date -u +%FT%TZ 2>/dev/null || echo unknown)"

  # Cap each bd call so a wedged DB lock can never hold up the merge.
  _to="$(_pick_timeout)"
  run_bd() {
    if [ -n "${_to}" ]; then
      "${_to}" 30 bd --db "${beads_db}" "$@"
    else
      bd --db "${beads_db}" "$@"
    fi
  }

  for _bead in ${beads}; do
    _json="$(run_bd show "${_bead}" --json 2>/dev/null || true)"
    # Absent from this store (e.g. a cross-store id) -> skip, do not error.
    if [ -z "${_json}" ] || ! printf '%s' "${_json}" | grep -q '"id"'; then
      printf '[%s] %s: not in %s — skipped\n' "${_ts}" "${_bead}" "${beads_db}" \
        >> "${_log_file}" 2>/dev/null || true
      continue
    fi
    # Already closed -> idempotent skip (don't re-stamp the reason / audit log).
    if printf '%s' "${_json}" | grep -qE '"status"[[:space:]]*:[[:space:]]*"closed"'; then
      printf '[%s] %s: already closed — skipped\n' "${_ts}" "${_bead}" \
        >> "${_log_file}" 2>/dev/null || true
      continue
    fi
    if run_bd close "${_bead}" --reason "post-merge: PR landed on ${default_branch}" \
        >> "${_log_file}" 2>&1; then
      echo "[post-merge:beads] ✓ closed ${_bead} (merged to ${default_branch})" >&2
    else
      echo "[post-merge:beads] ✗ could not close ${_bead} — git op unaffected (see ${_log_file})" >&2
    fi
  done
}

# ── Stage 2: reap provably-merged worktrees ────────────────────────────────
sweep_merged_worktrees() {
  [ "${AGM_POST_MERGE_SWEEP:-1}" = "0" ] && return 0
  command -v agm >/dev/null 2>&1 || return 0

  log_dir="${HOME}/.claude/logs"
  mkdir -p "${log_dir}" 2>/dev/null || true
  log_file="${log_dir}/worktree-post-merge.log"
  ts="$(date -u +%FT%TZ 2>/dev/null || echo unknown)"

  printf '[%s] post-merge on %s: launching `agm worktree sweep --execute`\n' \
    "${ts}" "${default_branch}" >> "${log_file}" 2>/dev/null || true

  # Prefer gtimeout (macOS coreutils) then timeout; run bare if neither exists.
  timeout_bin=""
  for t in gtimeout timeout; do
    if command -v "$t" >/dev/null 2>&1; then
      timeout_bin="$t"
      break
    fi
  done

  # run_sweep executes the canonical reaper with a per-invocation timeout. The
  # GIT_* hook env is cleared so the sweep operates on the repos it discovers
  # under ~/worktrees, not on this hook's repo context.
  run_sweep() {
    if [ -n "${timeout_bin}" ]; then
      env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
        "${timeout_bin}" 120 agm worktree sweep --execute
    else
      env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
        agm worktree sweep --execute
    fi
  }

  if [ "${AGM_POST_MERGE_SWEEP_SYNC:-0}" = "1" ]; then
    run_sweep >> "${log_file}" 2>&1
  else
    # Detach so the merge/pull returns immediately; the sweep is fail-safe and
    # self-logging.
    run_sweep >> "${log_file}" 2>&1 &
  fi
}

# ── Run the stages (each self-scopes and is individually fail-safe) ─────────
# Order: rebuild the go-install binaries, then deploy the host artifacts (a plist
# may point at a freshly-rebuilt binary, so binaries go first), then verify the
# agm deploy, then sweep merged worktrees.
if [ -n "${DEAR_AGENT_POST_MERGE_INTERNAL_MODE:-}" ]; then
  rebuild_changed_binaries
  exit $?
fi

rebuild_changed_binaries
deploy_host_artifacts
verify_deployment_after_rebuild
transition_merged_beads
sweep_merged_worktrees

exit 0
