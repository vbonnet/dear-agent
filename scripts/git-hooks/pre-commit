#!/usr/bin/env bash
#
# Git pre-commit hook — routing guard.
#
# Blocks temporal artifacts (Wayfinder SDLC runs, retros, designs, research)
# from entering this code repo. Thin wrapper over the routing-guard Go tool,
# whose forbidden globs come from .dear-agent.yml (single source of truth, no
# drift). The Wayfinder TOOL SOURCE (wayfinder/, *.go, ADR-036) is NOT blocked.
#
# Prefers a prebuilt ./build/routing-guard (installed by
# `make install-routing-guard-hook`); falls back to `go run`.
#
# Bypass (discouraged; CI enforces the same rule on the PR): git commit --no-verify

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

if [ -x "$root/build/routing-guard" ]; then
  "$root/build/routing-guard" --staged
elif command -v go >/dev/null 2>&1; then
  ( cd "$root" && go run ./cmd/routing-guard --staged )
else
  echo "pre-commit: routing-guard unavailable (no ./build/routing-guard, no go)" >&2
  exit 0
fi
