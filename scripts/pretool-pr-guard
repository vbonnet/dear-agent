#!/bin/bash
# Canonical command classifier and guidance for repository PR-lifecycle hooks.
#
# Input is a decoded Bash command on stdin. The classifier intentionally covers
# cooperative literal command forms, including common command runners. It is a
# shift-left workflow guard, not a shell security boundary, and fails open on
# empty or unrecognized input.

set -uo pipefail

cmd="$(cat)"
[ -n "$cmd" ] || exit 0

# BEGIN CANONICAL PR GUARD CORE
verb="$(printf '%s' "$cmd" | awk '
  function base(p){ sub(/.*\//,"",p); return p }
  function is_assignment(t) { return t ~ /^[A-Za-z_][A-Za-z0-9_]*(\[[^]]+\])?\+?=/ }
  function is_control_prefix(t) { return t ~ /^(!|if|then|elif|while|until|do|else|\{)$/ }
  function is_compound_prefix(t) { return t ~ /^(\{|if|while|until|for|case|select|\[\[|\(\()$/ }
  function is_launcher(p) {
    return p ~ /^(gtimeout|timeout|env|command|builtin|exec|sudo|nohup|time|nice|caffeinate|stdbuf|xargs)$/
  }
  function env_short_action(t, chars, i, ch) {
    if (t !~ /^-[^-]/) return 0
    chars=substr(t,2)
    for (i=1; i<=length(chars); i++) {
      ch=substr(chars,i,1)
      if (ch ~ /^[0iv]$/) continue
      if (ch ~ /^[uCP]$/) return i<length(chars) ? 3 : 2
      if (ch=="S") return i<length(chars) ? 5 : 4
      return 0
    }
    return 1
  }
  function runner_takes_value(r, t) {
    if (r=="env") return t ~ /^(-u|--unset|-C|--chdir|--argv0|-P)$/
    if (r=="exec") return t=="-a"
    if (r=="sudo") return t ~ /^(-u|--user|-g|--group|-h|--host|-p|--prompt|-C|--close-from|-T|--command-timeout|-R|--chroot|-D|--chdir|-r|--role|-t|--type|-U|--other-user)$/
    if (r ~ /^(gtimeout|timeout)$/) return t ~ /^(-k|--kill-after|-s|--signal)$/
    if (r=="nice") return t ~ /^(-n|--adjustment)$/
    if (r=="stdbuf") return t ~ /^(-i|--input|-o|--output|-e|--error)$/
    if (r=="xargs") return t ~ /^(-n|--max-args|-L|--max-lines|-P|--max-procs|-s|--max-chars|-E|-I|--replace|-a|--arg-file|-d|--delimiter|-J|-R|-S)$/
    if (r=="caffeinate") return t ~ /^(-w|-t)$/
    if (r=="time") return t ~ /^(-f|-o)$/
    return 0
  }
  function runner_attached_value(r, t) {
    if (r=="env") return t ~ /^-[uCP].+/ || t ~ /^--(unset|chdir|argv0)=/
    if (r=="exec") return t ~ /^-a.+/
    if (r=="sudo") return t ~ /^-[ughpcTRDrtU].+/ || t ~ /^--(user|group|host|prompt|close-from|command-timeout|chroot|chdir|role|type|other-user)=/
    if (r ~ /^(gtimeout|timeout)$/) return t ~ /^-[ks].+/ || t ~ /^--(kill-after|signal)=/
    if (r=="nice") return t ~ /^-n.+/ || t ~ /^--adjustment=/ || t ~ /^-[0-9]+$/
    if (r=="stdbuf") return t ~ /^-[ioe].+/ || t ~ /^--(input|output|error)=/
    if (r=="xargs") return t ~ /^-[nLPsEIadJRS].+/ || t ~ /^--(max-args|max-lines|max-procs|max-chars|replace|arg-file|delimiter)=/
    if (r=="caffeinate") return t ~ /^-[wt].+/
    if (r=="time") return t ~ /^-[fo].+/
    return 0
  }
  function runner_boolean(r, t) {
    if (r=="env") return t=="-" || t ~ /^-[0iv]+$/ || t ~ /^(--ignore-environment|--null|--debug)$/
    if (r=="exec") return t ~ /^(-c|-l)$/
    if (r=="sudo") return t ~ /^(-A|-b|-E|-e|-H|-K|-k|-n|-P|-S|-V|-v|--askpass|--background|--preserve-env|--preserve-env=.+|--edit|--set-home|--remove-timestamp|--reset-timestamp|--non-interactive|--stdin|--validate)$/
    if (r ~ /^(gtimeout|timeout)$/) return t ~ /^(-f|-p|-v|--foreground|--preserve-status|--verbose)$/
    if (r=="command") return t=="-p"
    if (r=="time") return t ~ /^(-a|-h|-l|-p|-v)$/
    if (r=="caffeinate") return t ~ /^-[dimsu]+$/
    if (r=="xargs") return t ~ /^(-0|--null|-o|--open-tty|-p|--interactive|-r|--no-run-if-empty|-t|--verbose|-x|--exit|--show-limits)$/
    return 0
  }
  function runner_nonexecuting(r, t, position) {
    if (position==1 && t ~ /^--(help|version)$/) return 1
    if (r=="command" && t ~ /^-[vV]$/) return 1
    if (r=="sudo" && t ~ /^(-V|-l|-v|-K|--list|--validate|--remove-timestamp)$/) return 1
    return 0
  }
  function exact_program(a, start, end, r, i, t, position, options, env_action) {
    options=1
    for (i=start+1; i<=end; i++) {
      t=a[i]; position=i-start
      if (runner_nonexecuting(r,t,position)) return -1
      if (r=="time" && t=="!") continue
      if (r=="env" && is_assignment(t)) { options=0; continue }
      if (r ~ /^(sudo|time)$/ && is_assignment(t)) continue
      if (t=="--") {
        if (r ~ /^(gtimeout|timeout)$/) return i+1<end ? i+2 : -1
        return i<end ? i+1 : -1
      }
      if (t ~ /^-/) {
        if (r=="env" && !options) return i
        if (r=="env" && (env_action=env_short_action(t))) {
          if (env_action==4 || env_action==5) return 0
          if (env_action==2) { i++; if (i>end) return -1 }
          continue
        }
        if (r=="env" && (t ~ /^(-S|--split-string)$/ || t ~ /^-S./ || t ~ /^--split-string=/)) return 0
        if (runner_takes_value(r,t)) { i++; if (i>end) return -1; continue }
        if (runner_attached_value(r,t) || runner_boolean(r,t)) continue
        return 0
      }
      if (r ~ /^(gtimeout|timeout)$/) return i<end ? i+1 : -1
      return i
    }
    return -1
  }
  function gh_global_value(t) {
    return t=="-R" || t=="--repo" || t=="--hostname"
  }
  function gh_global_attached(t) {
    return t ~ /^-R.+/ || t ~ /^(--repo|--hostname)=/
  }
  function mutation_value(verb, t) {
    if (t ~ /=/) return 0
    if (verb=="merge")
      return t ~ /^(-A|--author-email|-b|--body|-F|--body-file|--match-head-commit|-t|--subject)$/
    if (verb=="create")
      return t ~ /^(-a|--assignee|-B|--base|-b|--body|-F|--body-file|-H|--head|-l|--label|-m|--milestone|-p|--project|--recover|-r|--reviewer|-T|--template|-t|--title)$/
    if (verb=="close") return t ~ /^(-c|--comment|-r|--reason)$/
    if (verb=="reopen") return t ~ /^(-c|--comment)$/
    return 0
  }
  function true_bool(v) { return v ~ /^(1|t|T|true|TRUE|True)$/ }
  function false_bool(v) { return v ~ /^(0|f|F|false|FALSE|False)$/ }
  function plain_help(t, v) {
    if (t=="-h" || t=="--help" || t ~ /^-h=/) return 1
    if (t ~ /^--help=/) { v=t; sub(/^--help=/,"",v); return true_bool(v) }
    return 0
  }
  function mutation_help(verb, t, cluster) {
    if (plain_help(t)) return 1
    if (t !~ /^-[^-]/) return 0
    cluster=substr(t,2)
    sub(/=.*/,"",cluster)
    if (cluster !~ /h/) return 0
    if (verb=="merge") return cluster ~ /^[hdmrs]+$/
    if (verb=="create") return cluster ~ /^[hdefw]+$/
    if (verb=="close") return cluster ~ /^[hd]+$/
    return 0
  }
  function has_help_after(a, verb, at, end, i, t, skip) {
    skip=0
    for (i=at+1; i<=end; i++) {
      t=a[i]
      if (skip) { skip=0; continue }
      if (t=="--") break
      if (gh_global_value(t) || mutation_value(verb,t)) { skip=1; continue }
      if (mutation_help(verb,t)) return 1
    }
    return 0
  }
  function mutation_at(a, at, end, i, t, sub_seen, help_before, value) {
    sub_seen=0; help_before=0
    for (i=at+1; i<=end; i++) {
      t=a[i]
      if (!sub_seen) {
        if (gh_global_value(t)) { i++; continue }
        if (gh_global_attached(t)) continue
        if (plain_help(t)) { help_before=1; continue }
        if (t ~ /^--help=/) { value=t; sub(/^--help=/,"",value); if (false_bool(value)) continue }
        if (t=="pr") { sub_seen=1; continue }
        return ""
      }
      if (gh_global_value(t)) { i++; continue }
      if (gh_global_attached(t)) continue
      if (plain_help(t)) { help_before=1; continue }
      if (t ~ /^-/) continue
      if (t ~ /^(create|close|reopen|merge)$/) {
        if (help_before || has_help_after(a,t,i,end)) return ""
        return t
      }
      return ""
    }
    return ""
  }
  function env_escape(ch) {
    if (ch=="f") return sprintf("%c",12)
    if (ch=="n") return "\n"
    if (ch=="r") return "\r"
    if (ch=="t") return "\t"
    if (ch=="v") return sprintf("%c",11)
    return ch
  }
  function hex_digit(ch, pos) {
    pos=index("0123456789abcdef",tolower(ch))
    return pos ? pos-1 : -1
  }
  function safe_heredoc_delimiter(t) { return t ~ /^[A-Za-z0-9_.:\/+-]+$/ }

  # env -S has its own grammar: spaces and tabs split words, \_ is a word
  # boundary outside quotes, shell separators are literal, and ${NAME} expands
  # from envs inherited by the inspected command. Parsed words are prepended
  # with env because split-string results are reprocessed as env arguments.
  function env_split_and_classify(s, outer, env_at, next_at, end, depth, words, n, word, active, quote, sq, parse_error, stop, i, ch, next_ch, close_at, name, value, known, j, found) {
    words[1]="env"; n=1; word=""; active=0; quote=""; sq=sprintf("%c",39); parse_error=0; stop=0
    for (i=1; i<=length(s); i++) {
      ch=substr(s,i,1)
      if (quote==sq) {
        if (ch==sq) { quote=""; continue }
        if (ch=="\\" && i<length(s)) {
          next_ch=substr(s,i+1,1)
          if (next_ch==sq || next_ch=="\\") { word=word next_ch; active=1; i++; continue }
        }
        word=word ch; active=1; continue
      }
      if (quote=="\"") {
        if (ch=="\"") { quote=""; continue }
        if (ch=="\\") {
          if (i==length(s)) { parse_error=1; break }
          next_ch=substr(s,i+1,1); i++
          if (next_ch=="c") { parse_error=1; break }
          if (next_ch=="_") { word=word " "; active=1; continue }
          if (next_ch !~ /^[fnrtv#\$\"\\]$/ && next_ch!=sq) { parse_error=1; break }
          word=word env_escape(next_ch); active=1; continue
        }
        if (ch=="$" && substr(s,i+1,1)=="{") {
          close_at=index(substr(s,i+2),"}")
          if (!close_at) { parse_error=1; break }
          name=substr(s,i+2,close_at-1); value=""; known=0
          if (name !~ /^[A-Za-z_][A-Za-z0-9_]*$/) { parse_error=1; break }
          for (j=1; j<env_at; j++) {
            if (substr(outer[j],1,length(name)+1)==name "=") { value=substr(outer[j],length(name)+2); known=1 }
          }
          if (!known && name in ENVIRON) { value=ENVIRON[name]; known=1 }
          if (known) word=word value
          active=1; i+=close_at+1; continue
        }
        word=word ch; active=1; continue
      }
      if (ch==sq || ch=="\"") { quote=ch; active=1; continue }
      if (ch=="\\") {
        if (i==length(s)) { parse_error=1; break }
        next_ch=substr(s,i+1,1); i++
        if (next_ch=="_") {
          if (active) { words[++n]=word; word=""; active=0 }
          continue
        }
        if (next_ch=="c") { stop=1; break }
        if (next_ch !~ /^[fnrtv#\$\"\\]$/ && next_ch!=sq) { parse_error=1; break }
        word=word env_escape(next_ch); active=1; continue
      }
      if (ch=="$" && substr(s,i+1,1)=="{") {
        close_at=index(substr(s,i+2),"}")
        if (!close_at) { parse_error=1; break }
        name=substr(s,i+2,close_at-1); value=""; known=0
        if (name !~ /^[A-Za-z_][A-Za-z0-9_]*$/) { parse_error=1; break }
        for (j=1; j<env_at; j++) {
          if (substr(outer[j],1,length(name)+1)==name "=") { value=substr(outer[j],length(name)+2); known=1 }
        }
        if (!known && name in ENVIRON) { value=ENVIRON[name]; known=1 }
        if (known && value!="") { word=word value; active=1 }
        i+=close_at+1; continue
      }
      if (ch ~ /[ \t]/) {
        if (active) { words[++n]=word; word=""; active=0 }
        continue
      }
      if (ch=="#" && !active) { stop=1; break }
      word=word ch; active=1
    }
    if (parse_error || quote!="") return ""
    if (active) words[++n]=word
    for (j=next_at; j<=end; j++) words[++n]=outer[j]
    if (n>1) return classify_tokens(words,1,n,depth)
    return ""
  }

  function env_split_at(a, start, end, depth, i, t, c, next_at, action, chars, pos) {
    if (depth>=16) return ""
    for (i=start+1; i<=end; i++) {
      t=a[i]
      if (t=="--") return ""
      action=env_short_action(t)
      if (action==4 || t=="--split-string") {
        if (i>=end) return ""
        c=a[i+1]; next_at=i+2
      } else if (action==5) {
        chars=substr(t,2); pos=index(chars,"S"); c=substr(chars,pos+1)
        next_at=i+1
      } else if (t ~ /^--split-string=/) {
        c=t; sub(/^--split-string=/,"",c); next_at=i+1
      } else continue

      return env_split_and_classify(c,a,start,next_at,end,depth+1)
    }
    return ""
  }

  function classify_tokens(a, start, end, depth, first, scan_start, saw_env, program, found, i, split_found) {
    while (start<=end && (is_assignment(a[start]) || is_control_prefix(a[start]))) start++
    if (start>end) return ""
    if (a[start]=="coproc") {
      if (start+2<=end && a[start+1] ~ /^[A-Za-z_][A-Za-z0-9_]*$/ && is_compound_prefix(a[start+2]))
        return classify_tokens(a,start+2,end,depth)
      return classify_tokens(a,start+1,end,depth)
    }
    first=base(a[start])
    if (first=="gh") {
      return mutation_at(a,start,end)
    }
    if (!is_launcher(first)) return ""

    scan_start=start; saw_env=(first=="env")
    program=exact_program(a,start,end,first)
    if (program==0 && first=="env") {
      split_found=env_split_at(a,start,end,depth)
      if (split_found!="") return split_found
    }
    while (program>0 && is_launcher(base(a[program]))) {
      start=program; first=base(a[program]); saw_env=saw_env || first=="env"
      program=exact_program(a,start,end,first)
      if (program==0 && first=="env") {
        split_found=env_split_at(a,start,end,depth)
        if (split_found!="") return split_found
      }
    }
    if (program<0) return ""
    if (program>0) {
      if (base(a[program])=="gh") return mutation_at(a,program,end)
      return ""
    }

    # Runner options are platform-specific. For ambiguous option-bearing
    # launchers, inspect every literal gh or nested-launcher candidate instead
    # of trusting the first candidate or losing a later env -S command.
    for (i=scan_start+1; i<=end; i++) {
      first=base(a[i])
      if (first=="gh") found=mutation_at(a,i,end)
      else if (is_launcher(first)) found=classify_tokens(a,i,end,depth)
      else continue
      if (found!="") return found
    }
    return ""
  }

  # Tokenize shell words, redirections, and simple-command separators without
  # evaluating the command. Quotes and escapes define word boundaries, so
  # assignment/option values cannot manufacture or hide standalone syntax.
  function lex_and_classify(s, depth, words, hdelim, htab, pieces, n, word, active, protected, discard, heredoc_capture, heredoc_tabs, hcount, quote, sq, parse_error, heredoc_missing, matched, i, ch, next_ch, h1, h2, code, close_at, name, value, trimmed, part_count, p, found, j, k, line_start, line_size, line, compared) {
    n=0; word=""; active=0; protected=0; discard=0; heredoc_capture=0; heredoc_tabs=0; hcount=0; quote=""; sq=sprintf("%c",39); parse_error=0; heredoc_missing=0
    for (i=1; i<=length(s); i++) {
      ch=substr(s,i,1)
      if (quote=="A") {
        if (ch==sq) { quote=""; continue }
        if (ch=="\\" && i<length(s)) {
          next_ch=substr(s,i+1,1)
          if (next_ch=="x") {
            h1=hex_digit(substr(s,i+2,1))
            if (h1>=0) {
              code=h1; i+=2; h2=hex_digit(substr(s,i+1,1))
              if (h2>=0) { code=code*16+h2; i++ }
              word=word sprintf("%c",code); active=1; continue
            }
          }
          i++
          if (next_ch=="a") word=word sprintf("%c",7)
          else if (next_ch=="b") word=word sprintf("%c",8)
          else if (next_ch=="e" || next_ch=="E") word=word sprintf("%c",27)
          else if (next_ch ~ /^[fnrtv\\\"?]$/ || next_ch==sq) word=word env_escape(next_ch)
          else word=word "\\" next_ch
          active=1; continue
        }
        word=word ch; active=1; continue
      }
      if (quote==sq) {
        if (ch==sq) quote=""
        else { word=word ch; active=1 }
        continue
      }
      if (quote=="\"") {
        if (ch=="\"") { quote=""; continue }
        if (ch=="\\") {
          if (i==length(s)) { parse_error=1; break }
          next_ch=substr(s,i+1,1)
          if (next_ch=="$" || next_ch=="`" || next_ch=="\"" || next_ch=="\\") {
            word=word next_ch; active=1; i++; continue
          }
          if (next_ch=="\n") { i++; continue }
        }
        if (ch=="$" && substr(s,i+1,2)=="((") {
          close_at=index(substr(s,i+3),"))")
          if (!close_at) { parse_error=1; break }
          word=word "__PR_GUARD_ARITH__"; active=1; protected=1; i+=close_at+3; continue
        }
        if (ch=="$" && substr(s,i+1,1)=="{") {
          close_at=index(substr(s,i+2),"}")
          if (!close_at) { parse_error=1; break }
          name=substr(s,i+2,close_at-1)
          if (name !~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
            word=word "${" name "}"; active=1; i+=close_at+1; continue
          }
          if (discard && heredoc_capture) word=word "${" name "}"
          else { value=(name in ENVIRON) ? ENVIRON[name] : ""; word=word value }
          active=1; i+=close_at+1; continue
        }
        word=word ch; active=1; continue
      }
      if (ch=="$" && substr(s,i+1,2)=="((") {
        close_at=index(substr(s,i+3),"))")
        if (!close_at) { parse_error=1; break }
        word=word "__PR_GUARD_ARITH__"; active=1; protected=1; i+=close_at+3; continue
      }
      if (ch=="$" && (substr(s,i+1,1)==sq || substr(s,i+1,1)=="\"")) {
        quote=substr(s,i+1,1)==sq ? "A" : "\""; active=1; protected=1; i++; continue
      }
      if (ch==sq || ch=="\"") { quote=ch; active=1; protected=1; continue }
      if (ch=="\\") {
        if (i==length(s)) { parse_error=1; break }
        next_ch=substr(s,i+1,1); i++
        if (next_ch=="\n") continue
        word=word next_ch; active=1; protected=1; continue
      }
      if (ch=="$" && substr(s,i+1,1)=="{") {
        close_at=index(substr(s,i+2),"}")
        if (!close_at) { parse_error=1; break }
        name=substr(s,i+2,close_at-1)
        if (name !~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
          word=word "${" name "}"; active=1; i+=close_at+1; continue
        }
        protected=1
        if (discard && heredoc_capture) { word=word "${" name "}"; active=1 }
        else {
          value=(name in ENVIRON) ? ENVIRON[name] : ""
          if (discard || is_assignment(word)) { word=word value; active=1 }
          else { trimmed=value; sub(/^[ \t\r\n]+/,"",trimmed); sub(/[ \t\r\n]+$/,"",trimmed) }
          if (!discard && !is_assignment(word) && trimmed!="") {
            part_count=split(trimmed,pieces,/[ \t\r\n]+/)
            for (p=1; p<=part_count; p++) {
              if (p>1 && active) {
                if (!discard) words[++n]=word
                else {
                  if (heredoc_capture && safe_heredoc_delimiter(word)) { hdelim[++hcount]=word; htab[hcount]=heredoc_tabs }
                  heredoc_capture=0
                  discard=0
                }
                word=""; active=0; protected=0
              }
              word=word pieces[p]; active=1; protected=1; delete pieces[p]
            }
          }
        }
        i+=close_at+1; continue
      }
      if (ch=="#" && !active && !discard) {
        while (i<length(s) && substr(s,i+1,1)!="\n") i++
        continue
      }
      if (ch=="(" && substr(s,i+1,1)=="(" && !active && !discard) {
        close_at=index(substr(s,i+2),"))")
        if (close_at) { i+=close_at+2; continue }
      }
      if (ch ~ /[ \t\r]/) {
        if (active) {
          if (!discard) words[++n]=word
          else {
            if (heredoc_capture && safe_heredoc_delimiter(word)) { hdelim[++hcount]=word; htab[hcount]=heredoc_tabs }
            heredoc_capture=0
            discard=0
          }
          word=""; active=0; protected=0
        }
        continue
      }
      if (ch=="<" || ch==">" || (ch=="&" && substr(s,i+1,1)==">")) {
        if (active) {
          if (!discard && (protected || (word !~ /^[0-9]+$/ && word !~ /^\{[A-Za-z_][A-Za-z0-9_]*\}$/))) words[++n]=word
          else if (discard && heredoc_capture) {
            if (safe_heredoc_delimiter(word)) { hdelim[++hcount]=word; htab[hcount]=heredoc_tabs }
            heredoc_capture=0
          }
          word=""; active=0; protected=0
        }
        discard=1
        heredoc_capture=(ch=="<" && substr(s,i+1,1)=="<" && substr(s,i+2,1)!="<")
        heredoc_tabs=(heredoc_capture && substr(s,i+2,1)=="-")
        if (ch=="&") i++
        while (i<length(s) && substr(s,i+1,1) ~ /^[<>]$/) i++
        if (heredoc_tabs && i<length(s) && substr(s,i+1,1)=="-") i++
        if (i<length(s) && substr(s,i+1,1) ~ /^[&|]$/) i++
        continue
      }
      if (ch==";" || ch=="|" || ch=="&" || ch=="\n" || ch=="(" || ch==")") {
        if (active) {
          if (!discard) words[++n]=word
          else if (heredoc_capture) {
            if (safe_heredoc_delimiter(word)) { hdelim[++hcount]=word; htab[hcount]=heredoc_tabs }
            heredoc_capture=0
          }
          word=""; active=0; protected=0; discard=0
        } else if (discard) discard=0
        if (n>0) {
          found=classify_tokens(words,1,n,depth)
          if (found!="") return found
          for (j=1; j<=n; j++) delete words[j]
          n=0
        }
        if (ch=="\n" && hcount>0) {
          for (k=1; k<=hcount; k++) {
            matched=0
            line_start=i+1
            while (line_start<=length(s)) {
              line_size=index(substr(s,line_start),"\n")
              if (line_size) line=substr(s,line_start,line_size-1)
              else line=substr(s,line_start)
              compared=line
              if (htab[k]) sub(/^\t*/,"",compared)
              if (compared==hdelim[k]) {
                i=line_size ? line_start+line_size-1 : length(s)
                matched=1
                break
              }
              if (!line_size) break
              line_start+=line_size
            }
            if (!matched) { heredoc_missing=1; break }
          }
          for (k=1; k<=hcount; k++) { delete hdelim[k]; delete htab[k] }
          hcount=0
          if (heredoc_missing) { heredoc_missing=0; continue }
        }
        continue
      }
      word=word ch; active=1
    }
    if (parse_error || quote!="") return ""
    if (active && !discard) words[++n]=word
    else if (active && heredoc_capture && safe_heredoc_delimiter(word)) { hdelim[++hcount]=word; htab[hcount]=heredoc_tabs }
    if (n>0) return classify_tokens(words,1,n,depth)
    return ""
  }

  { source=source (NR==1 ? "" : "\n") $0 }
  END {
    found=lex_and_classify(source,0)
    if (found!="") print found
  }')"
[ -n "$verb" ] || exit 0

if [ "$verb" = "merge" ]; then
  cat >&2 <<'EOF'
You're trying to run a raw gh merge command directly. Merging goes through the
vetted wrapper, and merge DIAGNOSIS goes through the deterministic classifier:

  pr-blockers <number>      # exact blocker(s) + exact fix from GitHub state
  safe-merge --pr <number>  # the sanctioned, gated, audited merge path

Never infer a merge blocker from code reading or CI re-runs; use pr-blockers.
Install once with `make install-pr-blockers install-safe-merge` if not on PATH.

If you need this permission to complete your task, escalate by reporting:
'PERMISSION_ESCALATION: I need [specific permission] because [reason]'.
EOF
  exit 2
fi

if [ "$verb" = "reopen" ]; then
  guidance='Reopening a closed PR has no sanctioned automated path — it is a human decision.
Ask the supervisor/user to reopen it (and say why), or escalate.'
else
  guidance="  safe-pr create --wayfinder <wayfinder-project-dir> --title \"...\" --body \"...\" [gh flags]
  safe-pr close  --wayfinder <wayfinder-project-dir> <number|url>

(or set WAYFINDER_PROJECT_DIR; from outside AGM, run
\`agm escalate ask --session <registered-session> \"Please perform the blocked PR lifecycle action: $verb\"\`;
if no registered session exists, ask the current user directly).
Install once with \`make install-safe-pr\` if not on PATH."
fi

cat >&2 <<EOF
You're trying to run \`gh pr $verb\` directly. PR open/close must go through
the safe-pr wrapper so every PR carries a wayfinder session trace:

$guidance

Why: raw PRs have no wayfinder/plan attribution and no telemetry, and PR spray
has repeatedly outrun the serial merge pipeline, burning CI and review quota
(AGENTS.md §PR Lifecycle, principle 9 — atomic action wrappers).

If you need this permission to complete your task, escalate by reporting:
'PERMISSION_ESCALATION: I need [specific permission] because [reason]'.
EOF
exit 2
# END CANONICAL PR GUARD CORE
