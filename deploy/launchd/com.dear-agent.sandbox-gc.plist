<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the periodic sandbox sweep (ce-uxju).

  Requests `agm sandbox gc --reap --json` hourly. SGC-18 currently contains
  that destructive request: each tick exits non-zero before session-store or
  candidate access until endpoint-authenticated transport exists. Operators
  should expect the reaper-liveness alarm during containment; `agm sandbox gc`
  remains the read-only diagnostic. On 2026-07-03 the sandbox dir grew to 2.3T
  across 541 dirs and crashed the host twice; this job is retained as the
  periodic backstop for when authenticated authority is restored.

  Safety gates (internal/sandboxgc — a reap happens ONLY when ALL pass):
    - allowlist path validation (directly under ~/.agm/sandboxes)
    - no non-archived session references the sandbox (aborts if the session
      store is unreachable or empty)
    - no process holds a cwd/open fd inside the sandbox (lsof)
    - after a best-effort unmount, the mount table is RE-READ and the reap
      refuses if any mount point remains inside (deleting through a live
      overlay mount can destroy the source repo — ~/.agm/cleanup-runbook.md)
    - sandboxes modified within the last hour are never touched

  The plist is a TEMPLATE: __HOME__ is substituted for the real home
  directory before staging into ~/Library/LaunchAgents (launchd does not
  expand ~ or shell variables). Stage with:
    make install-sandbox-gc-launchagent

  Activate (ask-gated host action — run a manual dry-run first:
  `agm sandbox gc`):
    launchctl bootstrap gui/$(id -u) \
      ~/Library/LaunchAgents/com.dear-agent.sandbox-gc.plist

  Trigger an immediate run outside the schedule:
    launchctl kickstart gui/$(id -u)/com.dear-agent.sandbox-gc

  Remove:
    launchctl bootout gui/$(id -u)/com.dear-agent.sandbox-gc
    rm ~/Library/LaunchAgents/com.dear-agent.sandbox-gc.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dear-agent.sandbox-gc</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/go/bin/agm</string>
    <string>sandbox</string>
    <string>gc</string>
    <string>--reap</string>
    <string>--json</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <!--
      DOLT_PORT remains available to the read-only inventory scan and records
      the legacy endpoint expected by this retained template. It is not
      endpoint authentication. Under SGC-18, --reap refuses before reading this
      setting or contacting the endpoint, and no DOLT_HOST, port, password,
      SQLite path, or other ambient override can bypass that containment.
    -->
    <key>DOLT_PORT</key>
    <string>3307</string>

    <!--
      Declares which runner produced each record this sweep writes. The disk
      watchdog reads the same log to answer "is this hourly schedule still
      alive?", and it invokes `agm sandbox gc --reap` itself on every breached
      tick. SGC-18 currently refuses both requests before a completion record;
      after authenticated transport restores destructive execution, the tag
      prevents watchdog remediation from becoming proof this schedule is alive
      (cmd/disk-watchdog, DW-29). An older agm ignores an unknown variable, so
      setting it is safe on a mixed-version host.
    -->
    <key>AGM_GC_SOURCE</key>
    <string>launchd-sandbox-gc</string>
  </dict>

  <!-- One tick per hour. Each tick is idempotent; every reap re-verifies all
       safety gates, so overlapping state changes only cause skips. -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>AbandonProcessGroup</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/dear-agent/sandbox-gc.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/dear-agent/sandbox-gc.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <!-- Working dir: user's home. launchd otherwise starts jobs with cwd=/ (ce-k414). -->
  <key>WorkingDirectory</key>
  <string>__HOME__</string>
</dict>
</plist>
