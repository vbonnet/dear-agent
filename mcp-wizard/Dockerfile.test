FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Copy source code first (needed for any install scripts)
COPY src ./src
COPY tests ./tests

# Install dependencies - use --ignore-scripts to avoid build during install
RUN npm ci --ignore-scripts

# Now run the build
RUN npm run build

# Run integration tests by default
CMD ["npm", "test", "--", "tests/integration/"]
