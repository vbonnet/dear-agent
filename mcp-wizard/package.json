{
  "name": "mcp-wizard",
  "version": "0.1.0",
  "description": "Automated MCP setup tool",
  "main": "dist/index.js",
  "bin": {
    "mcp-wizard": "bin/mcp-wizard.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=__integration__",
    "test:e2e": "jest --config=jest.e2e.config.js",
    "test:e2e:watch": "jest --config=jest.e2e.config.js --watch",
    "test:e2e:coverage": "jest --config=jest.e2e.config.js --coverage",
    "docker:test": "docker-compose up --build --abort-on-container-exit",
    "docker:clean": "docker-compose down -v",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check src/**/*.ts tests/**/*.ts",
    "prepublish": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "exponential-backoff": "^3.1.0",
    "glob": "^10.0.0",
    "googleapis": "^148.0.0",
    "inquirer": "^9.2.0",
    "keytar": "^7.9.0",
    "open": "^10.0.0",
    "ora": "^7.0.0",
    "pino": "^8.0.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/inquirer": "^9.0.0",
    "@types/jest": "^29.0.0",
    "@types/keytar": "^4.4.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autocannon": "^8.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nock": "^13.5.6",
    "oauth2-mock-server": "^7.0.0",
    "pino-pretty": "^10.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/mcp-wizard.git"
  },
  "author": "MCP Wizard Contributors",
  "license": "MIT"
}
