#!/usr/bin/env bash
# AGY adapter for the canonical repository PR-lifecycle guard.
# The canonical guidance includes `agm escalate ask --session <registered-session>`
# and tells unregistered callers to ask the current user directly.

set -uo pipefail

project_root="${CLAUDE_PROJECT_DIR:-${PI_PROJECT_DIR:-}}"
if [ -z "$project_root" ]; then
  hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)" || exit 0
  project_root="$(CDPATH= cd -- "$hook_dir/../.." && pwd -P)" || exit 0
fi

guard="$project_root/.claude/hooks/pretool-pr-guard"
[ -x "$guard" ] || exit 0
exec "$guard"
