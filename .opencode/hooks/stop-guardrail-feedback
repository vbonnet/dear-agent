#!/usr/bin/env bash
# Stop / SubagentStop hook: the WF-A guardrail feedback loop (bead ce-vrux).
#
# WHAT: when an agent is about to finish, run the deterministic guardrail
# bundle (scripts/guardrail-bundle.sh — vet+build+lint today; Semgrep/arch
# tests via WF-B/WF-C tomorrow). If the bundle is RED, block the stop and feed
# *natural-language* remediation back into the live agent via the Stop-hook
# `{"decision":"block","reason":...}` contract, so it keeps working until the
# guardrails are green — the "keep going until green" loop. This is the
# keystone that lets every other guardrail close back into the agent on the
# laptop, as close to code-generation as possible, instead of in GitHub CI.
#
# WHY a block here, not a nudge (contrast pretool-spawn-routing): a failing
# guardrail at stop-time is the exact moment a human reviewer would have said
# "not done — fix this first." Surfacing it as additionalContext alone would
# let the agent stop on red. So we block — but with positive guidance
# (principle 2): the reason explains what failed, how to fix it, and how to
# bow out, never a bare "you can't stop."
#
# WHY it cannot wedge a session (principle 2 + anti-stall): three independent
# brakes — (1) a per-session attempt counter capped at MAX_ITERS yields control
# back to the human after a bounded number of tries; (2) it only acts when the
# working tree is dirty, so read-only / chat / planning turns are never touched;
# (3) it fails OPEN — any missing tool, unreadable input, non-repo cwd, or
# unwritable state exits 0 and lets the stop proceed. Opt out for a session with
# `export DEAR_GUARDRAIL_LOOP=0`.
#
# SCOPE (principle 1): WF-A owns the *loop mechanism* only. The guardrail
# *checks* live behind scripts/guardrail-bundle.sh and grow in WF-B/WF-C. This
# hook neither knows nor cares what the bundle runs.
set -uo pipefail

# --- fail-open preconditions -------------------------------------------------
command -v jq >/dev/null 2>&1 || exit 0
input="$(cat)"
[ -n "$input" ] || exit 0

# Global opt-out for an interactive session that doesn't want the loop.
[ "${DEAR_GUARDRAIL_LOOP:-1}" = "0" ] && exit 0

# Never run inside GitHub Actions. The loop is an *authoring*-time guardrail —
# "delivered on your laptop instead of in GitHub CI", per the WHAT above — and
# the only agent that loads these hooks in Actions is the read-only PR reviewer
# (claude-code-action sets settingSources: user,project,local, so this repo's
# .claude/settings.json applies there too).
#
# In that container all three of the anti-wedge brakes above fail at once:
#   - The tree is *always* dirty: the action restores .claude/, CLAUDE.md &c
#     from origin/main over the untrusted PR head and drops the PR's copies in
#     .claude-pr/, so `git status --porcelain` is never empty — the "read-only
#     turns are never touched" brake cannot engage.
#   - The bundle is *always* red: the review job installs Node and the Claude
#     CLI only, so preflight's go vet/build/lint have no toolchain to run.
#   - So every review run blocks the stop MAX_ITERS times and hands the
#     reviewer a "go fix the guardrails" prompt. It then burns turns on build
#     and lint commands the review permission set denies, and the run ends
#     is_error:true (observed: 13 turns, 87 denials, $4.43, 10min on PR #1149).
#
# Gating here rather than via DEAR_GUARDRAIL_LOOP=0 in the workflow is
# deliberate: the workflow file comes from the untrusted PR head, this file is
# restored from main, so this is the trustworthy place to put it.
[ -n "${GITHUB_ACTIONS:-}" ] && exit 0

event="$(printf '%s' "$input" | jq -r '.hook_event_name // empty' 2>/dev/null || true)"
case "$event" in
  Stop|SubagentStop) ;;
  *) exit 0 ;;  # never fire on other events
esac

session="$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null || true)"
# Secondary loop brake (used only if the attempt counter can't be persisted):
# true when this stop was itself triggered by a prior stop-hook block.
stop_active="$(printf '%s' "$input" | jq -r '.stop_hook_active // false' 2>/dev/null || echo false)"
cwd="$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null || true)"
[ -n "$cwd" ] || cwd="${CLAUDE_PROJECT_DIR:-$PWD}"

# Resolve the repo root from cwd; if it isn't a git repo, there is nothing to
# guard — fail open.
root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || exit 0

bundle="$root/scripts/guardrail-bundle.sh"
[ -f "$bundle" ] || exit 0

# Only act when the agent actually changed something. A clean tree means the
# guardrails have nothing to say about this turn.
[ -n "$(git -C "$root" status --porcelain 2>/dev/null)" ] || exit 0

# --- attempt-budget bookkeeping ----------------------------------------------
MAX_ITERS="${DEAR_GUARDRAIL_MAX_ITERS:-3}"
state_dir="${CLAUDE_STATE_DIR:-$HOME/.claude/state}/guardrail-loop"
# Key the counter by session so concurrent agents don't share a budget. Sanitize
# to a filesystem-safe token; fall back to a constant if the id is absent.
key="$(printf '%s' "${session:-nosession}" | tr -c 'A-Za-z0-9._-' '_')"
count_file="$state_dir/$key.count"
mkdir -p "$state_dir" 2>/dev/null || true
count=0
[ -f "$count_file" ] && count="$(cat "$count_file" 2>/dev/null || echo 0)"
case "$count" in *[!0-9]*|'') count=0 ;; esac

# --- run the guardrail bundle ------------------------------------------------
out="$(cd "$root" && bash "$bundle" 2>&1)"; rc=$?

if [ "$rc" -eq 0 ]; then
  # Green: clear the counter and let the agent stop.
  rm -f "$count_file" 2>/dev/null || true
  exit 0
fi

# Red. Truncate the bundle output so the feedback prompt stays readable.
trimmed="$(printf '%s' "$out" | tail -c 4000)"
[ "$(printf '%s' "$out" | wc -c)" -gt 4000 ] && trimmed="...(earlier output trimmed)...
$trimmed"

attempt=$((count + 1))

emit_block() { # $1 = reason text -> block the stop, feed reason to the agent
  jq -cn --arg r "$1" '{decision:"block",reason:$r}'
  exit 0
}
emit_context() { # $1 = text -> non-blocking note, let the agent stop
  jq -cn --arg c "$1" --arg e "$event" \
    '{hookSpecificOutput:{hookEventName:$e,additionalContext:$c}}'
  exit 0
}

if [ "$attempt" -gt "$MAX_ITERS" ]; then
  # Budget exhausted — stop blocking so we never wedge the agent. Surface the
  # unresolved state, reset, and hand control back to the human.
  rm -f "$count_file" 2>/dev/null || true
  emit_context "Guardrails are still failing after ${MAX_ITERS} automated attempts, so the WF-A loop is yielding control rather than retrying further (anti-stall). The remaining failures are below — please resolve them or escalate before relying on this change.

${trimmed}"
fi

# Wrap the write so that even a failure to *open* the target (state dir is
# unwritable or not a directory) is silenced — the brake below handles it.
write_count() { printf '%s' "$attempt" > "$count_file"; }
if ! write_count 2>/dev/null; then
  # Counter is untrackable (unwritable state dir). Fall back to the harness's
  # own loop flag so a broken state dir can't spin us forever: if this stop was
  # already a continuation of a prior block, yield instead of blocking again.
  [ "$stop_active" = "true" ] && emit_context "Guardrails are still failing and the WF-A loop cannot persist its attempt counter (state dir unwritable), so it is yielding control rather than risk an unbounded loop. Remaining failures:

${trimmed}"
fi

emit_block "GUARDRAILS FAILING — not done yet (WF-A stop-hook loop, attempt ${attempt}/${MAX_ITERS}).

You're about to finish, but the guardrail bundle is red. This is the same feedback a human reviewer would have given you, delivered on your laptop instead of in CI — fix it before stopping rather than shipping a known-red change.

${trimmed}

Do this:
  1. Read the failures above and fix the *root cause* — do not suppress, skip, or comment out the check to make it pass.
  2. Re-run locally to confirm green:  scripts/guardrail-bundle.sh   (or: make preflight)
  3. When it passes, finish normally — the loop will let you stop.

If a failure is a genuine false positive or truly out of scope for this task, state that explicitly in your next message and stop anyway: the loop yields after ${MAX_ITERS} attempts and will not wedge you. To disable it for this session: export DEAR_GUARDRAIL_LOOP=0"
