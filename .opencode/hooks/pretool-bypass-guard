#!/usr/bin/env bash
# PreToolUse hook: intercepts bypass flags removed from our tools (ADR-031).
# OpenCode harness port of .claude/hooks/pretool-bypass-guard.
#
# Fails OPEN: any parse error exits 0 — this hook must never wedge a session.

set -uo pipefail

input="$(cat)"
tool="$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null || true)"
[ "$tool" = "Bash" ] || exit 0

cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
[ -n "$cmd" ] || exit 0

block() {
  local tool_name="$1" flag="$2" approved_path="$3"
  local msg="BLOCKED: ${tool_name} ${flag} is not an approved flag.

You are trying to bypass a safety gate with ${flag}.
Approved path: ${approved_path}

If no approved path exists and this is an AGM session, escalate via:
  agm escalate ask --kind blocked-action --context \"<why this flag was needed>\" \"<describe what you need>\"
Outside AGM, add --session <registered-session>; if none exists, ask the current user directly.
The command creates a durable escalation record and routes it through supervisory review; it does not create or update a Bead."
  jq -cn --arg m "$msg" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",additionalContext:$m},permissionDecision:"deny",denialReason:$m}'
  exit 2
}

# safe-pr --emergency
if printf '%s' "$cmd" | grep -qE '(^|[[:space:]])safe-pr([[:space:]]|$)' \
   && printf '%s' "$cmd" | grep -q -- '--emergency'; then
  block "safe-pr lifecycle" "a retired bypass flag" \
    "safe-pr create --wayfinder <project-dir> --title '...' --body '...'"
fi

# safe-merge --skip-bot-review
if printf '%s' "$cmd" | grep -qE '(^|[[:space:]])safe-merge([[:space:]]|$)' \
   && printf '%s' "$cmd" | grep -q -- '--skip-bot-review'; then
  block "safe-merge" "--skip-bot-review" \
    "safe-merge --pr <num> --watch"
fi

# git commit --no-verify
if printf '%s' "$cmd" | grep -qE '(^|[[:space:]])git([[:space:]].*)?commit' \
   && printf '%s' "$cmd" | grep -q -- '--no-verify'; then
  block "git commit" "--no-verify" \
    "Fix the pre-commit hook failure — hooks catch real problems; bypassing them hides defects"
fi

# git push force forms, blocked when they can reach a protected destination.
#
# Preferred path: `safe-push --check` runs the same internal/safegit policy the
# Go tools use, so shell and Go cannot drift into two different answers. It is
# used only when the installed binary advertises the flag, because an older one
# would forward --check to git and actually push.
#
# Fallback path: parse the destination rather than matching command text. Two
# independent regexes could not agree on `git push -f origin HEAD:main`, and
# the lease form used to be exempted wholesale even when it named main.
if printf '%s' "$cmd" | grep -qE '(^|[[:space:]])git([[:space:]].*)?push' \
   && printf '%s' "$cmd" | grep -qE -- '(^|[[:space:]])(-[[:alnum:]]*f[[:alnum:]]*|--force|--force-with-lease|--force-if-includes|--mirror|--all|--tags)([=[:space:]]|$)'; then
  push_args="$(printf '%s' "$cmd" | sed -E 's/^.*[[:space:]]push([[:space:]]+|$)//')"
  push_verdict=allow
  if command -v safe-push >/dev/null 2>&1 && safe-push --help 2>/dev/null | grep -q -- '--check'; then
    safe-push --check $push_args >/dev/null 2>&1 || push_verdict=block
  else
    push_verdict="$(printf '%s' "$push_args" | awk '
      BEGIN { seen_remote = 0; refspecs = 0 }
      {
        for (i = 1; i <= NF; i++) {
          a = $i
          if (a == "--" || a ~ /^-/) continue
          if (!seen_remote) { seen_remote = 1; continue }
          refspecs++
          d = a; sub(/^\+/, "", d)
          if (index(d, ":") > 0) sub(/^[^:]*:/, "", d)
          sub(/^\+/, "", d); sub(/^refs\/heads\//, "", d)
          if (d == "main" || d == "master" || d == "HEAD" || d == "@" || index(d, "*") > 0) {
            print "block"; exit
          }
        }
        # No refspec means git resolves the destination from configuration,
        # which is not knowable from the command text.
        if (refspecs == 0) print "block"; else print "allow"
      }')"
    [ -n "$push_verdict" ] || push_verdict=block
  fi
  if [ "$push_verdict" = block ]; then
    block "git push" "--force" \
      "Use normal PR/merge flow for main/master/default; force-push only non-default PR branches, preferably with --force-with-lease"
  fi
fi

exit 0
