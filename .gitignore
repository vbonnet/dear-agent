.local/

# Local audit database (created by `workflow-audit run`)
.dear-agent/

# `make preflight` mirrors ci.yml and writes the three matrix binaries here.
/build/

# Wayfinder SDLC run artifacts are TEMPORAL — they belong in
# engram-research/wf/<project>/, never in this code repo. Ignoring the run
# directories + status files keeps a stray local Wayfinder run from being
# `git add`'d by accident (defense-in-depth alongside the routing guard in
# .dear-agent.yml + scripts/check-forbidden-artifacts.sh). This does NOT match
# the Wayfinder TOOL SOURCE under wayfinder/, which is living code.
/wf/
**/.wayfinder/
WAYFINDER-STATUS.md
WAYFINDER-HISTORY.md

# Private infra inventory (repo names + per-repo security posture).
# The real file must NEVER be committed to this PUBLIC repo; the .example
# documents the schema. See infra/variables.tf active_repos/archived_repos.
infra/*.tfvars
!infra/*.tfvars.example
!infra/*.auto.tfvars.example

# Compiled token-refresher binary (built into the repo root by `go build ./cmd/token-refresher`)
/token-refresher

# Compiled ai-review binary (built into the repo root by `go build ./cmd/ai-review`)
/ai-review
