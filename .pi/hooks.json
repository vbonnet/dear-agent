{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"command": "${PI_PROJECT_DIR}/.pi/guardrails/pretool-spawn-routing", "timeout": 5, "type": "command"}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"command": "${PI_PROJECT_DIR}/.pi/guardrails/pretool-bead-close-guard", "timeout": 30, "type": "command"}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"command": "${PI_PROJECT_DIR}/.pi/guardrails/pretool-bypass-guard", "timeout": 5, "type": "command"}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"command": "${PI_PROJECT_DIR}/.pi/guardrails/pretool-pr-guard", "timeout": 5, "type": "command"}]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"command": "go run \"${PI_PROJECT_DIR}/cmd/spec-contract-hook\" --root \"${PI_PROJECT_DIR}\" --provider pi --event Stop", "timeout": 60, "type": "command"},
          {"command": "${PI_PROJECT_DIR}/.pi/guardrails/stop-guardrail-feedback", "timeout": 120, "type": "command"}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"command": "go run \"${PI_PROJECT_DIR}/cmd/spec-contract-hook\" --root \"${PI_PROJECT_DIR}\" --provider pi --event SubagentStop", "timeout": 60, "type": "command"},
          {"command": "${PI_PROJECT_DIR}/.pi/guardrails/stop-guardrail-feedback", "timeout": 120, "type": "command"}
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{"command": "bd --db ~/beads/context-engine/.beads --dolt-auto-commit on codex-hook SessionStart", "timeout": 30, "type": "command"}]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"command": "bd --db ~/beads/context-engine/.beads --dolt-auto-commit on codex-hook UserPromptSubmit", "timeout": 30, "type": "command"}]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{"command": "bd --db ~/beads/context-engine/.beads --dolt-auto-commit on codex-hook PreCompact", "timeout": 30, "type": "command"}]
      }
    ],
    "PostCompact": [
      {
        "hooks": [{"command": "bd --db ~/beads/context-engine/.beads --dolt-auto-commit on codex-hook PostCompact", "timeout": 30, "type": "command"}]
      }
    ]
  }
}
