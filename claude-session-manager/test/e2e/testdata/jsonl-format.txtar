# Test: JSONL format round-trip validation
# Validates: JSONL format (FR2.2), XML→JSONL migration
#
# This test ensures that:
# - New sessions create .jsonl files (not .xml)
# - JSONL files contain valid JSON objects (one per line)
# - First line contains session_start event
# - Format is properly structured for Phase 0 requirements

# Create a test session
exec csm new bdd-jsonl-test
stdout 'Session.*created'

# Verify JSONL file exists
exists $HOME/sessions/bdd-jsonl-test/session.jsonl

# Verify XML file does NOT exist (Phase 0 migration from XML to JSONL)
! exists $HOME/sessions/bdd-jsonl-test/session.xml

# Verify first line is valid JSON session_start event
exec head -n 1 $HOME/sessions/bdd-jsonl-test/session.jsonl
# Should be a valid JSON object (starts with { and ends with })
stdout '^\{.*\}$'
# Should contain session_start type
stdout '"type":"session_start"'

# Verify file is not empty (contains at least one line)
exec wc -l $HOME/sessions/bdd-jsonl-test/session.jsonl
stdout '[1-9][0-9]*'

# Verify each line is valid JSON (basic structure check)
# JSONL format: each line must be a complete JSON object
exec cat $HOME/sessions/bdd-jsonl-test/session.jsonl
# Every line should start with { (JSON object start)
# Note: testscript validates line-by-line, so this is a basic sanity check

# Verify manifest references JSONL format (if applicable)
exec cat $HOME/sessions/bdd-jsonl-test/manifest.yaml
stdout 'schema_version: "3.0"'

# Cleanup
exec csm archive bdd-jsonl-test --force
