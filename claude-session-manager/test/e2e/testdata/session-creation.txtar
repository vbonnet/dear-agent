# Test: Session creation with Manifest v3 and JSONL format
# Validates: Core session creation (FR1.1), Manifest v3 (FR2.3), JSONL format (FR2.2)
#
# This test ensures that:
# - csm new command creates a session successfully
# - Manifest v3 format is used (schema_version: "3.0")
# - Session ID is a proper UUID (not "session-<name>")
# - JSONL file is created (not XML)
# - JSONL contains valid JSON session_start event

# Create a new session
exec csm new bdd-create-test
stdout 'Session.*created'

# Verify directory structure exists
exists $HOME/sessions/bdd-create-test/manifest.yaml
exists $HOME/sessions/bdd-create-test/session.jsonl

# Verify XML format is NOT used (Phase 0 migration)
! exists $HOME/sessions/bdd-create-test/session.xml

# Verify Manifest v3 schema
exec cat $HOME/sessions/bdd-create-test/manifest.yaml
stdout 'schema_version: "3.0"'

# Verify session_id is a proper UUID (not "session-<name>" pattern from old bug)
stdout 'session_id: [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
! stdout 'session_id: session-bdd-create-test'
! stdout 'session_id: session-'

# Verify name field is set correctly
stdout 'name: bdd-create-test'

# Verify JSONL format (first line should be session_start event)
exec head -n 1 $HOME/sessions/bdd-create-test/session.jsonl
stdout '\{"type":"session_start"'

# Cleanup
exec csm archive bdd-create-test --force
