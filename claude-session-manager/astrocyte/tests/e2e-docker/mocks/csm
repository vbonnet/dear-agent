#!/bin/bash
# Mock CSM command for astrocyte E2E testing
# Tracks calls and simulates csm send/reject behavior

MOCK_LOG="/home/testuser/.csm/astrocyte/logs/csm-mock.log"
mkdir -p "$(dirname "$MOCK_LOG")"

# Log the call
echo "[$(date -Iseconds)] csm $*" >> "$MOCK_LOG"

case "$1" in
    "send")
        # Mock: csm send <session> --prompt-file <file>
        SESSION="$2"
        PROMPT_FILE="$4"

        if [ -z "$SESSION" ] || [ -z "$PROMPT_FILE" ]; then
            echo "Error: Invalid arguments for csm send" >&2
            exit 1
        fi

        if [ ! -f "$PROMPT_FILE" ]; then
            echo "Error: Prompt file not found: $PROMPT_FILE" >&2
            exit 1
        fi

        # Simulate successful send
        echo "[csm send] Sent prompt to session $SESSION" >> "$MOCK_LOG"
        echo "Prompt sent to session $SESSION"
        exit 0
        ;;

    "reject")
        # Mock: csm reject <session> --reason-file <file>
        SESSION="$2"
        REASON_FILE="$4"

        if [ -z "$SESSION" ] || [ -z "$REASON_FILE" ]; then
            echo "Error: Invalid arguments for csm reject" >&2
            exit 1
        fi

        # Simulate successful rejection
        echo "[csm reject] Rejected permission prompt in session $SESSION" >> "$MOCK_LOG"
        echo "Permission prompt rejected in session $SESSION"
        exit 0
        ;;

    *)
        echo "Error: Unknown csm command: $1" >&2
        exit 1
        ;;
esac
