# Test: Configuration defaults and environment overrides

# Test: Default config values when no config file exists
exec agm list --test --log-level debug
stderr 'sessions directory'
# Should use default ~/sessions

# Test: Environment variable override
env AGM_SESSIONS_DIR=$HOME/custom-sessions
mkdir $HOME/custom-sessions
cp env-test.yaml $HOME/custom-sessions/

exec agm list --test
stdout 'env-test'

# Test: Config file override
mkdir $HOME/.config/agm
cp config.yaml $HOME/.config/agm/
mkdir $HOME/config-sessions
cp config-test.yaml $HOME/config-sessions/

# Clear env var to test config file
env -u AGM_SESSIONS_DIR

exec agm list --test --config $HOME/.config/agm/config.yaml
stdout 'config-test'
! stdout 'env-test'

# Test: Command-line flag takes highest precedence
exec agm list --test --sessions-dir $HOME/custom-sessions
stdout 'env-test'
! stdout 'config-test'

-- env-test.yaml --
schema_version: "2"
session_id: sess-env-001
name: env-test
created_at: 2024-01-01T12:00:00Z
updated_at: 2024-01-01T12:00:00Z
context:
  project: /tmp/test
tmux:
  session_name: env-test
agent: claude

-- config-test.yaml --
schema_version: "2"
session_id: sess-config-001
name: config-test
created_at: 2024-01-01T12:00:00Z
updated_at: 2024-01-01T12:00:00Z
context:
  project: /tmp/test
tmux:
  session_name: config-test
agent: claude

-- config.yaml --
sessions_dir: $HOME/config-sessions
log_level: debug
timeout:
  tmux_commands: 10s
  enabled: true
lock:
  enabled: true
  path: /tmp/agm-test.lock
health_check:
  enabled: false
