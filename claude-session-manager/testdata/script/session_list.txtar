# Test: List AGM sessions with filters

# Copy test manifests to sessions directory
mkdir $HOME/sessions
cp active-session.yaml $HOME/sessions/
cp stopped-session.yaml $HOME/sessions/
cp archived-session.yaml $HOME/sessions/

# Test: List without --all (should exclude archived)
exec agm list --test
stdout 'active-session'
stdout 'stopped-session'
! stdout 'archived-session'

# Test: List with --all (should include archived)
exec agm list --all --test
stdout 'active-session'
stdout 'stopped-session'
stdout 'archived-session'

# Test: Empty sessions directory
mkdir $HOME/sessions-empty
exec agm list --test --sessions-dir $HOME/sessions-empty
stdout 'No sessions found'
stdout 'Create your first session'

-- active-session.yaml --
schema_version: "2"
session_id: sess-001
name: active-session
created_at: 2024-01-01T12:00:00Z
updated_at: 2024-01-01T12:00:00Z
lifecycle: ""
context:
  project: /home/user/projects/active
  purpose: Active development
  tags:
    - development
    - active
claude:
  uuid: uuid-active-001
tmux:
  session_name: active-session
agent: claude

