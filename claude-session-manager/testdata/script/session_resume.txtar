# Test: Resume existing AGM session

mkdir $HOME/sessions
cp my-project.yaml $HOME/sessions/

# Test: Resume by session name
# In test mode, resume should show session info without actually launching tmux/Claude
exec agm resume my-project --test --dry-run
stdout 'my-project'
stdout 'claude-uuid-12345'
stdout 'Project: /home/user/projects/my-project'

# Test: Resume non-existent session should fail
! exec agm resume nonexistent --test
stderr 'not found'

# Test: Fuzzy matching (if implemented)
# Typo "my-projet" should fuzzy match to "my-project"
exec agm resume my-projet --test --dry-run
stdout 'my-project'
stdout 'Did you mean'

# Test: Resume archived session should warn or fail
cp archived-project.yaml $HOME/sessions/

! exec agm resume archived-project --test
stderr 'archived'
stderr 'unarchive'

-- my-project.yaml --
schema_version: "2"
session_id: sess-my-project-001
name: my-project
created_at: 2024-01-01T12:00:00Z
updated_at: 2024-01-01T12:00:00Z
lifecycle: ""
context:
  project: /home/user/projects/my-project
  purpose: Project development
  tags:
    - development
    - feature-work
  notes: Working on authentication feature
claude:
  uuid: claude-uuid-12345
tmux:
  session_name: my-project
agent: claude

-- archived-project.yaml --
schema_version: "2"
session_id: sess-archived-001
name: archived-project
created_at: 2024-01-01T10:00:00Z
updated_at: 2024-01-01T11:00:00Z
lifecycle: "archived"
context:
  project: /home/user/projects/archived
claude:
  uuid: uuid-archived-001
tmux:
  session_name: archived-project
agent: claude
