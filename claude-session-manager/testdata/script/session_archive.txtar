# Test: Archive AGM session

mkdir $HOME/sessions
cp project-alpha.yaml $HOME/sessions/

# Verify session is initially active (not archived)
exec agm list --test
stdout 'project-alpha'

exec agm list --all --test
stdout 'project-alpha'

# Archive the session
exec agm archive project-alpha --test
stdout 'archived'
stdout 'project-alpha'

# Verify session is now archived
# List without --all should NOT show archived session
exec agm list --test
! stdout 'project-alpha'

# List with --all SHOULD show archived session
exec agm list --all --test
stdout 'project-alpha'

# Read manifest and verify lifecycle field updated
exec cat $HOME/sessions/project-alpha.yaml
stdout 'lifecycle: "archived"'

# Verify updated_at timestamp changed (should have new timestamp)
exec cat $HOME/sessions/project-alpha.yaml
stdout 'updated_at:'

# Test archiving non-existent session should fail
! exec agm archive nonexistent-session --test
stderr 'not found'

-- project-alpha.yaml --
schema_version: "2"
session_id: sess-alpha-001
name: project-alpha
created_at: 2024-01-01T12:00:00Z
updated_at: 2024-01-01T12:00:00Z
lifecycle: ""
context:
  project: /home/user/projects/alpha
  purpose: Development session
  tags:
    - active
    - development
claude:
  uuid: uuid-alpha-001
tmux:
  session_name: project-alpha
agent: claude
