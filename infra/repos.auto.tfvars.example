# repos.auto.tfvars.EXAMPLE  (safe to commit — placeholder names only)
#
# Copy to `repos.auto.tfvars` (gitignored) and fill in the REAL inventory.
# The real file holds private repo names + per-repo security posture and must
# NEVER be committed to this PUBLIC repo. `tofu` auto-loads any *.auto.tfvars.
#
# CI note: because the real file is gitignored, CI (tofu-plan / drift /
# reconcile) does not have it — provide the inventory to CI via secrets
# TF_VAR_active_repos / TF_VAR_archived_repos (JSON), or run those jobs from a
# private context that has the file.

active_repos = {
  "example-public-repo" = {
    visibility      = "public"
    default_branch  = "main"
    # Exact GitHub Actions check-run names required on main.
    required_checks = ["Build & Test"]
  }
  "example-private-repo" = {
    visibility     = "private"
    default_branch = "main"
    # Empty = branch protection applies but no CI gate (repo has no workflows).
    required_checks = []
  }
}

archived_repos = {
  # Archived repos: declared minimally, all changes ignored (GitHub rejects
  # mutations on archived repos; removing them would propose destroying the repo).
  "example-archived-repo" = { visibility = "private" }
}
