# repos.auto.tfvars.EXAMPLE  (safe to commit — placeholder names only)
#
# Copy to `repos.auto.tfvars` (gitignored) and fill in the REAL inventory.
# The real file holds private repo names + per-repo security posture and must
# NEVER be committed to this PUBLIC repo. `tofu` auto-loads any *.auto.tfvars.
#
# CI note: the pull-request fixture plan uses the dedicated public inventory in
# testdata/ci.tfvars.fixture. Real drift/reconcile jobs need the complete private
# inventory through TF_VAR_active_repos / TF_VAR_archived_repos (JSON), or a
# private context that has the real gitignored file.

active_repos = {
  "example-public-repo" = {
    visibility      = "public"
    default_branch  = "main"
    # Legacy context-only names remain supported while private inventory and
    # TF_VAR_active_repos are migrated. Prefer the structured identity list
    # below whenever GitHub reports an integration ID.
    required_checks = ["Build & Test"]
    required_check_identities = [{ context = "Build & Test", integration_id = 15368 }]
    # Installs the Claude Code review workflow through a normal rollout PR
    # (advisory, never required). Reset this to false after that PR merges so
    # its deleted rollout branch is not recreated. See claude_review.tf for
    # the default non-PII rollout list.
    enable_claude_review = true
    claude_review_rollout = true
  }
  "example-private-repo" = {
    visibility     = "private"
    default_branch = "main"
    # Empty = branch protection applies but no CI gate (repo has no workflows).
    required_checks = []
    # PII / private-research repos: leave this false (the default) — enabling
    # ships code to Anthropic's API for review, a data-handling call a human
    # must make explicitly. See claude_review.tf's PII list.
    # enable_claude_review = false
  }
}

archived_repos = {
  # Archived repos: declared minimally, all changes ignored (GitHub rejects
  # mutations on archived repos; removing them would propose destroying the repo).
  "example-archived-repo" = { visibility = "private" }
}
