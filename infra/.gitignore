# OpenTofu / Terraform working state — never commit these
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Real tfvars may contain owner-specific values; the .example is tracked.
*.tfvars
!terraform.tfvars.example

# Real backend config embeds the account-specific R2 endpoint; the .example
# is tracked, the live file is not.
backend.hcl

# Credentials
*.pem
*.token
.env
