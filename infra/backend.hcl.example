# Partial backend configuration for the S3-compatible R2 remote state.
# Copy to `backend.hcl` (gitignored) and fill in your values, then run:
#
#   tofu init -backend-config=backend.hcl
#
# Credentials are NOT set here — export them in the environment instead:
#   export AWS_ACCESS_KEY_ID="<R2 token Access Key ID>"
#   export AWS_SECRET_ACCESS_KEY="<R2 token Secret Access Key>"

# Name of the R2 bucket that holds the state (create it first — see README).
bucket = "vbonnet-tofu-state"

# R2 S3 API endpoint. ACCOUNT_ID is your Cloudflare account ID
# (`wrangler whoami`, or the Cloudflare dashboard → R2).
endpoints = {
  s3 = "https://ACCOUNT_ID.r2.cloudflarestorage.com"
}
