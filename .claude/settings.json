{
  "permissions": {
    "allow": [
      "Bash(safe-pr:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__scheduled-tasks__create_scheduled_task",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pretool-spawn-routing",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pretool-pr-guard",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
