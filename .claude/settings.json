{
  "permissions": {
    "allow": [
      "Bash(resolve-review-threads *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__scheduled-tasks__create_scheduled_task",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pretool-spawn-routing",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pretool-bead-close-guard",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pretool-bypass-guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pretool-pr-guard",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "go run \"${CLAUDE_PROJECT_DIR}/cmd/spec-contract-hook\" --root \"${CLAUDE_PROJECT_DIR}\" --provider claude --event UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "go run \"${CLAUDE_PROJECT_DIR}/cmd/spec-contract-hook\" --root \"${CLAUDE_PROJECT_DIR}\" --provider claude --event Stop",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-guardrail-feedback",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "go run \"${CLAUDE_PROJECT_DIR}/cmd/spec-contract-hook\" --root \"${CLAUDE_PROJECT_DIR}\" --provider claude --event SubagentStop",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-guardrail-feedback",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
