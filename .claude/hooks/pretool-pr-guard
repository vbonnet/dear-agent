#!/usr/bin/env bash
# Claude JSON adapter for the canonical repository PR-lifecycle guard.
# Classification and guidance live in scripts/pretool-pr-guard.
# That guidance includes `agm escalate ask --session <registered-session>` and
# tells unregistered callers to ask the current user directly.

set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0
input="$(cat)"
tool="$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null || true)"
[ "$tool" = "Bash" ] || exit 0
cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
[ -n "$cmd" ] || exit 0

project_root="${CLAUDE_PROJECT_DIR:-${PI_PROJECT_DIR:-}}"
if [ -z "$project_root" ]; then
  hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)" || exit 0
  project_root="$(CDPATH= cd -- "$hook_dir/../.." && pwd -P)" || exit 0
fi

guard="$project_root/scripts/pretool-pr-guard"
[ -x "$guard" ] || exit 0
printf '%s' "$cmd" | "$guard"
