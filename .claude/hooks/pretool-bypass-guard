#!/usr/bin/env bash
# PreToolUse hook: intercepts bypass flags removed from our tools (ADR-031).
#
# Blocks Bash commands that attempt to use flags that no longer exist
# (--emergency on safe-pr, --skip-bot-review on safe-merge) or that have
# never been approved (--no-verify on git, bare --force on git push).
# Returns exit code 2 with positive guidance (AGENTS.md principle 2).
#
# Fails OPEN: any parse error exits 0 — this hook must never wedge a session
# for a reason unrelated to the bypass it guards against.

set -uo pipefail

input="$(cat)"
tool="$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null || true)"
[ "$tool" = "Bash" ] || exit 0

cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
[ -n "$cmd" ] || exit 0

block() {
  local tool_name="$1" flag="$2" approved_path="$3"
  local msg="BLOCKED: ${tool_name} ${flag} is not an approved flag.

You are trying to bypass a safety gate with ${flag}.
Approved path: ${approved_path}

If no approved path exists and this is an AGM session, escalate via:
  agm escalate ask --kind blocked-action --context \"<why this flag was needed>\" \"<describe what you need>\"
Outside AGM, add --session <registered-session>; if none exists, ask the current user directly.
The command creates a durable escalation record and routes it through supervisory review; it does not create or update a Bead."
  jq -cn --arg m "$msg" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",additionalContext:$m},permissionDecision:"deny",denialReason:$m}'
  exit 2
}

# safe-pr --emergency (removed in ADR-031; wayfinder session required).
if printf '%s' "$cmd" | grep -qE '(^|[[:space:]])safe-pr([[:space:]]|$)' \
   && printf '%s' "$cmd" | grep -q -- '--emergency'; then
  block "safe-pr lifecycle" "a retired bypass flag" \
    "safe-pr create --wayfinder <project-dir> --title '...' --body '...'"
fi

# safe-merge --skip-bot-review (removed in ADR-031; wait for the bot or escalate).
if printf '%s' "$cmd" | grep -qE '(^|[[:space:]])safe-merge([[:space:]]|$)' \
   && printf '%s' "$cmd" | grep -q -- '--skip-bot-review'; then
  block "safe-merge" "--skip-bot-review" \
    "safe-merge --pr <num> --watch  (waits for the bot review gate to clear)"
fi

# git commit --no-verify (fix the hook, don't bypass it).
if printf '%s' "$cmd" | grep -qE '(^|[[:space:]])git([[:space:]].*)?commit' \
   && printf '%s' "$cmd" | grep -q -- '--no-verify'; then
  block "git commit" "--no-verify" \
    "Fix the pre-commit hook failure — hooks catch real problems; bypassing them hides defects"
fi

# git push force forms, blocked when they can reach a protected destination.
#
# Force-push is delegated whole to cmd/pretool-force-push-guard, which parses
# the command (per simple command, both `git push` and `safe-push`, with `cd`
# and -C tracked) and judges each destination with safegit.ForcePushViolation —
# the same function safe-push and the write guard call.
#
# It is delegated rather than reimplemented because the shell version answered a
# different question than the policy asked. It matched command *text*, so it
# refused `grep "git push --force"`, and it pooled a compound command's operands
# into one argument list, so `safe-push -u origin HEAD:main && safe-push -f
# origin feature/x` was refused for naming main in an unrelated earlier command.
# Both readings look like "force-push is denied on this host" from inside a
# session, and both stalled rebases that policy allows.
#
# Fallback when the binary is not installed: refuse only a force-push that
# plainly names main or master as its destination. It is deliberately narrower
# than the real policy — under-blocking here is caught by safe-push itself and
# by the GitHub ruleset's non_fast_forward on the default branch, whereas
# over-blocking is the defect this hook is being fixed for.
force_push_guard=""
for candidate in "${CLAUDE_PROJECT_DIR:-.}/bin/pretool-force-push-guard" \
                 "$HOME/.config/claude-code/hooks/pretool-force-push-guard"; do
  [ -x "$candidate" ] && force_push_guard="$candidate" && break
done
[ -n "$force_push_guard" ] || force_push_guard="$(command -v pretool-force-push-guard 2>/dev/null || true)"

if [ -n "$force_push_guard" ]; then
  guard_out="$(printf '%s' "$input" | "$force_push_guard" 2>/dev/null)"
  if [ $? -eq 2 ]; then
    printf '%s' "$guard_out"
    exit 2
  fi
elif printf '%s' "$cmd" | grep -qE '(^|[[:space:]])git([[:space:]].*)?push' \
   && printf '%s' "$cmd" | grep -qE -- '(^|[[:space:]])(-[[:alnum:]]*f[[:alnum:]]*|--force|--force-with-lease|--force-if-includes|--mirror)([=[:space:]]|$)' \
   && printf '%s' "$cmd" | grep -qE -- '(^|[[:space:]:+/])(main|master)([[:space:]]|$)'; then
  block "git push" "--force" \
    "Use normal PR/merge flow for main/master/default; force-push only non-default PR branches, preferably with --force-with-lease. Install the full guard with: make install-write-guards"
fi

exit 0
